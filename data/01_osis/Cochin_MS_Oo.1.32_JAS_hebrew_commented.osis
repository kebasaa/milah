      <work osisWork="MS.Oo.1.32">
        <title>James (Cochin MS Oo.1.32)</title>
        <scope>JAS</scope>
        <type type="x-manuscript">Manuscript</type>
        <identifier type="shelfmark">MS.Oo.1.32</identifier>
        <identifier type="URI">https://projecttruthministries.org/studies/cochin-james/</identifier>
        <publisher>Project Truth Ministries</publisher>
        <date event="original" type="ISO">ca. 1730</date>
        <description>Cochin Hebrew MS Oo.1.32, James portion, ca. 1730, Cochin, India.</description>
      </work>
    </header>
    <div type="book" osisID="Jas">
      <chapter osisID="Jas.1">
        <verse osisID="Jas.1.1" n="1">םדוקמ החמש תומוקמה לכב םירזפמה םיטבש רשע םינשל חישמה ֜ו֜שי ןודאו ה דבע בקעי</verse>
        <verse osisID="Jas.1.2" n="2">םילפוֹנ םתאש םאב החמשו תאז ובשחת םיבוהא יֵחא ןויסנב10</verse>
        <verse osisID="Jas.1.3" n="3">איהש םאב םכיתונומאש ועדו המילש11 תולבס איה םרוג <note type="footnote" n="10">Aramaic plural noun. 11 Aramaic noun. 12 See Exodus 6:7. Can also mean, “burden, forced labor,  compulsory service,  burden bearing.”</note> </verse>
        <verse osisID="Jas.1.4" n="4">האילמב ויהתש ידכ ףוסה דע תויהל ךירצ תולבס לבא13 םכממ רבד םלש רסחת חלצ אלו</verse>
        <verse osisID="Jas.1.5" n="5">ול ןתי אוה םגו םדא לכל ןתונש המ ללפתהל ךירצ הז המכח ול רסחש םכב דחא שיש םאב לבא <note type="footnote" n="13">Aramaic adverb first found in the Mishnah Shabbat 10:2 (c. 190  - 230 CE).</note> </verse>
        <verse osisID="Jas.1.6" n="6">ב אלו הנומאב ללפתהל ךירצ אוה לבאקפס14 םיה לע םינזאמל המוד אוה הז קפוסמש ימ יכ</verse>
        <verse osisID="Jas.1.7" n="7">ןודאהמ רבד הזיא לבקיש בשחל ךירצ הניא םדאה הזו <note type="footnote" n="14">Aramaic passive participle meaning, “In doubt.”</note> </verse>
        <verse osisID="Jas.1.8" n="8">לעכוקפוסמ15 ויכרד־לכב עדי ילב אוה</verse>
        <verse osisID="Jas.1.9" n="9">והבג תא ראפתהל לכוי לפשש דחא חא לבא <note type="footnote" n="15">Mishnaic word first found in Mishnah Perkei Avot 1:16.</note> </verse>
        <verse osisID="Jas.1.10" n="10">תא ראפתהל ךירצ רשועהו שבי הדש ץיצכ יכ ותלפש</verse>
        <verse osisID="Jas.1.11" n="11">דומעי אלו לצכ חרביו למיו אצי ץיצכו</verse>
        <verse osisID="Jas.1.12" n="12">לבקת םירוסיה רחא יכ סאמת לא ידש רסומו הולא ונחיכוי שונאה ירשאו ייוא בוהאש הלאל ֔ה חיטבמש םייחה רתכה</verse>
        <verse osisID="Jas.1.13" n="13">ש םאב דחא רמאת לאו ןויסנ16 םושל הסנמ הניא אוהו ערל םדא וא הסנמ אל ה יכ המ אב הז וילע אבדחא <note type="footnote" n="16">Aramaic noun meaning, “temptation.”</note> </verse>
        <verse osisID="Jas.1.14" n="14">קר ותוא חצנמ ותואתש םאב הסני דחא לכ</verse>
        <verse osisID="Jas.1.15" n="15">תומה איה םרוג אלכש םאב אטחה לבא אטחה איה םרוג הואתה לבקש םאב ֜כ ֜חאו</verse>
        <verse osisID="Jas.1.16" n="16">םיבוהא םיחא ועתת לא</verse>
        <verse osisID="Jas.1.17" n="17">ךשוחמו רואמ ףוליח שי אל ולצאו באה רואמ הלעמלמ אב הבוט הנתמ לכ</verse>
        <verse osisID="Jas.1.18" n="18">ותאירבמ םירוכב ונאש תמאה רוביד י״ע ונוצר יפכ ונל הארה אוהו</verse>
        <verse osisID="Jas.1.19" n="19">ףאל אלו רבדל אל לבא עומשל ריהמ תויהל ךירצ םדא ינב לכ םיבוהא םיחא הז ליבשב <note type="footnote" n="17">Literally, “fat, or fattened.”</note> </verse>
        <verse osisID="Jas.1.20" n="20">֔ה ינפל בוטש המ השוע וניא םדא ינבמ ףאה יכ</verse>
        <verse osisID="Jas.1.21" n="21"/>
        <verse osisID="Jas.1.22" n="22" alt:num="Jas.1.21">םיאמרמ ומצעבש דבל םיעמושהמ אלו רובידה םישועש וליאמ ויהת לבא םכתא</verse>
        <verse osisID="Jas.1.23" n="23" alt:num="Jas.1.22">תואבוצה תוארמב ומצע תא האורש שיאל המוד אוה הז השוע וניאל רובידה עמושה שי דחאש םאב יכ</verse>
        <verse osisID="Jas.1.24" n="24" alt:num="Jas.1.23">הארב המ תא חכושו ונממ אוה ךלוה ומצע תא הארש רחאש ןויכ</verse>
        <verse osisID="Jas.1.25" n="25" alt:num="Jas.1.24">וישעמ לכב שודק היהי הז השוע קר עמשש המ חכוש וניאו ותוא םייקמו החמשה תדב האולמב האורש ימ לבא</verse>
        <verse osisID="Jas.1.26" n="26" alt:num="Jas.1.25">תוריאשה הז ובבל תיסה קר ןסרב ונושל תא רמשמ וניאל ה דבוע אוהש ול בשחמ םכב דחאש םאב לבא18 ה</verse>
        <verse osisID="Jas.1.27" n="27" alt:num="Jas.1.26">ןורסח ילבמ רוהטה תוריאשהו19 םהיתורעצב תונמלא־תאו םימותיה רצבל ךלוהה אוה הז באה ה ינפל <note type="footnote" n="18">The aleph is a mater lectionis and is a Second Temple marker. 19 Aramaic noun meaning, “lack.”</note> </verse>
      </chapter>
      <chapter osisID="Jas.2">
        <verse osisID="Jas.2.1" n="1">םינפ אשונש ונינודא חישמה ושיב הנומאהש ובשחת לא םיבוהא םיחא</verse>
        <verse osisID="Jas.2.2" n="2">לצא דחא אביש םאב יכ ןיד תיבה ׃םיער םישובלמב ינע דחא םגו םיענ םישובלמבו בהז תעבטב <note type="footnote" n="20">Mishnaic term first found in the Mishnah Demai 7:3 and means, “house of judgment.”</note> </verse>
        <verse osisID="Jas.2.3" n="3">בש וא םש דומע ינעל םירמואו בוטה לע ונל בש ול םירמואו םיענ םישובלמה השונש הז לע םיאור םתא</verse>
        <verse osisID="Jas.2.4" n="4">ער קוליח ושעתו םיטפוש םתה קר הז לע בוטב םיחיגשמ םניאו</verse>
        <verse osisID="Jas.2.5" n="5">הלאל חיטבהש החטבהמ םישרויו הנומאב םירשועה־הזה םלועב םיינעב רחב ֔ה אלה םיבוהא םיחא יל םיעמוש ותוא בוהאש</verse>
        <verse osisID="Jas.2.6" n="6">טפשמו םכתא םאיצומו םכמע קזוחב לכה םישועש המה אלה םירישעהו ינעל שויב ושעת םתא לבא</verse>
        <verse osisID="Jas.2.7" n="7">םיפרחמ המה אלהו וארקת םתאש הזמ בוטה םשה םיפדגמו</verse>
        <verse osisID="Jas.2.8" n="8">בוט ושעת ךומכ ךיערל תבהאו הרותב בותכש יפכ תדה ושעת םתאש םאב</verse>
        <verse osisID="Jas.2.9" n="9">םירבועה ומכ תדמ שונעתו אטחו שעת םדאה לע םיאור םתאש םאב לבא</verse>
        <verse osisID="Jas.2.10" n="10">אוה דחאב אטוחו הלוכ הרותה לכ םייקמ דחאש םאב יכ בייחלכב <note type="footnote" n="21">Mishnaic term first found in the Mishnah Berakhot (c. 190 - 230 CE).</note> </verse>
        <verse osisID="Jas.2.11" n="11">תדה לע רבוע התא החיצר השעת לבא ףאנמ וניא התאש םאבו חצרת אל רמא אלה םג ףאנת אל רמאש הז יכ</verse>
        <verse osisID="Jas.2.12" n="12">החמשב תדה י״ע וטפשנש ולא ומכ ושעתו ורבדת הז ליכשכ</verse>
        <verse osisID="Jas.2.13" n="13">טפשמה דצכ ראפתמ םימחרהו םימחר השע אלש הז לע ער טפשמ אבי לבא</verse>
        <verse osisID="Jas.2.14" n="14">תלוכי שי אל הנומאהלו םישעמה ול שי אלו הנומאה ול שיש רמא דחאש םאב םיבוהא םיחא שי תלעות המו ותוא שדקל</verse>
        <verse osisID="Jas.2.15" n="15" alt:num="Jas.2.15">שיש םאבו םכל ןתי ה המחנ ירבד םהל רמאת םכמ דחאו םויו םוי לכ סנרפל םהל רסחש תוחא וא חא דחא םירבדה הזב םהל שי תלעות המ פוגה תלעותל רבד םוש םהל ןתי אל אוהו עבושל</verse>
        <verse osisID="Jas.2.16" n="16" alt:num="Jas.2.17">םישעמה ול שי אלש םאב הנומאה ךכ <note type="footnote" n="22">Cochin combines verses James 2:15 &amp; 16.</note> </verse>
        <verse osisID="Jas.2.17" n="17" alt:num="Jas.2.18">יל דיעה םישעמה ילו הנומאה שי ךל רמאל דחא לכוי לבא םישעמו יתנומא ךל דיעמ ינא םג ךישעמ םע ךתנומא</verse>
        <verse osisID="Jas.2.18" n="18" alt:num="Jas.2.19">התא םידערו םינימאמ ןכ םג םינטשה בוט השוע התא דחא הש ןימאת</verse>
        <verse osisID="Jas.2.19" n="19" alt:num="Jas.2.20">אוה תמ םישעמ ילב הנומאהש עדיל התא הצור לבא</verse>
        <verse osisID="Jas.2.20" n="20" alt:num="Jas.2.21">חבזמה לע ןברקל ונב תא איבהש וישעמ ע קדטצנ םהרבא וניתובא אלה</verse>
        <verse osisID="Jas.2.21" n="21" alt:num="Jas.2.22">האולמב הנומאה השענ םישעמה די לעו וישעמב לעפ הנומאהש תוארל התא לכות הזבו</verse>
        <verse osisID="Jas.2.22" n="22" alt:num="Jas.2.23">הקדצ ול הבשחיו הב ןימאה םהרבאו רמאנש הרותה אלממ הזבו</verse>
        <verse osisID="Jas.2.23" n="23" alt:num="Jas.2.24">ע דבל אלו םישעמה די לע קדטצנ םדאהש תוארל םתא םילוכי וישגעו הנומאה</verse>
        <verse osisID="Jas.2.24" n="24" alt:num="Jas.2.25">םנמטתו םילגרמה התחקלש ןויכ םישעמה ע קדטצנ איה אלה הנוזה בחר הזל המודכו</verse>
        <verse osisID="Jas.2.25" n="25" alt:num="Jas.2.26">תמ אוה םישעמ ילב הנומאה ךכ תמ אוה חור ילב ףוגהש ומכ יכ</verse>
      </chapter>
      <chapter osisID="Jas.3">
        <verse osisID="Jas.3.1" n="1">דמלמ לעב דחא לכ ויהת לא םיבוהא םיחאלודג רתוי היהי שנועהש ועדו</verse>
        <verse osisID="Jas.3.2" n="2">ףוגה לכ תא תסרל לכויו שודק שיא אוה רבד םושב אטח אלש ימו םירבד הברהב םיאטוח ונא יכ</verse>
        <verse osisID="Jas.3.3" n="3">ונינוצרכ םתוא גיהנהל ידכ ןסרב םיסוסה תא םיגהנמ ונאש הארו</verse>
        <verse osisID="Jas.3.4" n="4">פ״עא תוניפסה םגו ךאלמה דיב איהש הנטק אגה י״ע םיגהנמ ״כ פ״עא חורכ קזוחב םיכלוהו םילודג המהש</verse>
        <verse osisID="Jas.3.5" n="5">איה ןושלה ךכ לודג רעי רעבמ ןטק שא האר םילודג םירבד תלעופו הנטק רביא</verse>
        <verse osisID="Jas.3.6" n="6">םגוכ האולמ םלוע שא ומכ איה ןושלהתולווע ונתוא ריהבמו פיגה לכ תא איטחמו וניתורביאב ןושלה ךכ םנהיגמ רהבנ איהש םאב וניתכילהב <note type="footnote" n="23">Aramaic noun meaning, “wickedness.”</note> </verse>
        <verse osisID="Jas.3.7" n="7">םדאה לש עבטה ומכ איה םיב וא השביב המהש םישחנהו תופועהו תומהבה לכמ עבטה יכ</verse>
        <verse osisID="Jas.3.8" n="8">תומה םסב האולמו ער איה יכ תסרל םדא םוש לכוי אל ןושלה לבא</verse>
        <verse osisID="Jas.3.9" n="9">םיהלא םלצב אוהש םדאהל ונא םיללקמ זי עו באה הל ונא םיחבשמ ןושלה י״ע</verse>
        <verse osisID="Jas.3.10" n="10">םיבוהא םיחא ךכ היהת לאו תוללקו חבש אצ דחא יפמ</verse>
        <verse osisID="Jas.3.11" n="11">םימ הב שיש ןייעמ שי יכו םיקיתמו םיחולמ</verse>
        <verse osisID="Jas.3.12" n="12">םינאת לש ץע לכוי ואןתיל לכוי אל ןייעמה ךכ םינאת ןפג וא ןמש ןתיל םיקותמו םיחולמ םימ <note type="footnote" n="24">Mishnaic verb form that is a result of Aramism with the added yod (י).</note> </verse>
        <verse osisID="Jas.3.13" n="13">המכחב בוטה ותכילה יל הארמ םכב ןובנו םכח אוהש ימ</verse>
        <verse osisID="Jas.3.14" n="14">תמאה דעכ ורקשת לאו וראפתת לא האנשו האנק םכבבלב שיש םאב לבא</verse>
        <verse osisID="Jas.3.15" n="15">אבש המכח וניא הז יכ םינטשהמו םדאהמ המדאהמ קר הלעמלמ</verse>
        <verse osisID="Jas.3.16" n="16">םיער םירבד הברה שי הזב האנשו האנק שיש ימב יכ</verse>
        <verse osisID="Jas.3.17" n="17">לכויו תחנבו םולש כ חאו יקנ הליחתהל איה הלעמלמ המכחה לבא הסייפל תירחאו םימחר אלמ עומשל ריהמה תופינחו םינפ יואשמ אלו הבוטל</verse>
        <verse osisID="Jas.3.18" n="18">םולשה םימייקמה הליאל םולשב תערזנ תוקדצהמ תוריפה לבא <note type="footnote" n="25">Aramaic Peal verb binyan meaning, “to appease or to reconcile.”</note> </verse>
      </chapter>
      <chapter osisID="Jas.4">
        <verse osisID="Jas.4.1" n="1">םימחולה םכיתדמה ליבשב אלה םכיכותב המחלמ אב המ ליבשבו םכיתורביאב</verse>
        <verse osisID="Jas.4.2" n="2">םיללפתמ וניא םתאש ינפמ המ ליבשב לכהו הזב חיוורמ וניאו רטונו םקונו םילבקמ וניאו םייואתמ םתאו</verse>
        <verse osisID="Jas.4.3" n="3">הערב םיללפתמ םתאש ליבשב הנענ אלו הליפת םישוע םתאו</verse>
        <verse osisID="Jas.4.4" n="4">הזה םלועל בהוא תויהל הצורש ימו המ אנוש אוה הזה םלוע בהואש ימש םיעדוי םתא אלה תפאונהו ףאונה הל אנוש היהי</verse>
        <verse osisID="Jas.4.5" n="5">דגנכ הואתמ איה םכיותב רדש חורה םנחב רמא הרותהש םתבשחמ םתא זא ה תוויצה</verse>
        <verse osisID="Jas.4.6" n="6">םימרה תא ליפשמו םילפשה תא היבגמ הש רמא הרותהש ןויכ דסח הברה ןתונו</verse>
        <verse osisID="Jas.4.7" n="7">םכממ וחרבת םינטשה דגנכ ומחלתו הל םיענכומ ויהת וישכעו</verse>
        <verse osisID="Jas.4.8" n="8">יקנ םכבבל ושעתו םיאטוחה םכידי תא ורהטתו םכל אוה ברקו הל םכתא םיברקמו <note type="footnote" n="26">This appears to be a spelling error for the tav ( ת) should be a yod ( י) for the third common plural, meaning “they.” As spelled, this is translated as, “You will flee” and is nonsensical. .</note> </verse>
        <verse osisID="Jas.4.9" n="9">ל םכיתחמשו היכבל ךפהתת םכיקוצתו וכבו תולבס ואשנתו ןוגי</verse>
        <verse osisID="Jas.4.10" n="10">םכל אוה עמשי ה ינפל םכתא םיעינכמ <note type="footnote" n="27">Aramaic masculine noun meaning, “sorrow or mourning.” The lamed (ל) is serving as a direct object marker which is a second Temple Hebrew grammar marker.</note> </verse>
        <verse osisID="Jas.4.11" n="11">וכלת לא םיבוהא םיחא ליכר התא ןיא ןכ השעת התא םאו תדב ליכר אוה ויחאב ליכר ךלוהש ימ יכ םכינב תדה תא םייקמ</verse>
        <verse osisID="Jas.4.12" n="12">םירחאה תא טופשל התא ימ לבא לוחמלו שונעל לכויש תדה ןתונש רחא דבל שיו <note type="footnote" n="28">Aramaic feminine noun meaning, “slander.”</note> </verse>
        <verse osisID="Jas.4.13" n="13">ונא םיצור רחמ וא םויה םירמוא םתאש םאה וישכעו ךליל דחא םש דומעל ונא םיצורו תאזה ריעל וא םיקמל ןתמו אשמ תושעלו הנש</verse>
        <verse osisID="Jas.4.14" n="14">ךלוה אוה ךכ רחאו טעומ ןמזל אוה חור אלה םכיתוייח שי המ יכ רחמל תויהל לכויש המ םיעדוי אל םתאו <note type="footnote" n="29">Mishnaic word first found in Mishnah Eruvin 3:1 (c. 190 - 230 CE).</note> </verse>
        <verse osisID="Jas.4.15" n="15">תאז תושעל ונא םיצור םייח ה הצריש םאב רמול םיכירצ םתאו ונאו</verse>
        <verse osisID="Jas.4.16" n="16">ב םיראפתמ םתא וישכע לבאםכיתואג הערל איה תאזו <note type="footnote" n="30">Aramaic feminine noun meaning, “pride” or “glory."</note> </verse>
        <verse osisID="Jas.4.17" n="17">אטחל בשחנ הזל השוע הניאו בוט תושעל עדויש ימ יכ</verse>
      </chapter>
      <chapter osisID="Jas.5">
        <verse osisID="Jas.5.1" n="1">םכילע אביש הערה לע וכבו וקעצ םירישעה וישכעו</verse>
        <verse osisID="Jas.5.2" n="2">שעכ לכאמל התיה םכיתלמשו בקר םכיתרישע</verse>
        <verse osisID="Jas.5.3" n="3">םימיה תירחאב תורישע ולבקת םתאו שא ומכ םכרשב תא לכאיו תודעל םכל היהי הזו דולחי םכיבהזו םכיפסכו</verse>
        <verse osisID="Jas.5.4" n="4">תואבצ ןודאהמ םינזא ינפל אב םהיתוקעצו ינפל קעוצ ךילצא ןילתש ריכש תלועפ האר</verse>
        <verse osisID="Jas.5.5" n="5">לוקל וחמשו הזה םלוע תוואת םכל היהו בגוע</verse>
        <verse osisID="Jas.5.6" n="6">אל אוהו ותוא ותימתו קדצהל םיבייחמ םתאו החימ םכל <note type="footnote" n="31">Mishnaic word Pi’el verb binyan was first found in Mishnah Nazir 4:6.</note> </verse>
        <verse osisID="Jas.5.7" n="7">ותוקתו ץראה תוריפה לע הפצמ הדשה לעב האר ןודאהמ דיתעה לע הוקת םכל היהת םיבוהא םיחא וישכעו שוקלמו הרויה לע אוה</verse>
        <verse osisID="Jas.5.8" n="8">הבורק ןודאהמ דיתעש יכ םכבבל וקזח וקזח םתא ףאו <note type="footnote" n="32">This word means, “pinch” or “nipping” of a fruit.</note> </verse>
        <verse osisID="Jas.5.9" n="9">חתפה ינפל דמוע טפושה יכ הלקת ידיל ואובת אלש ידכ םיבוחא םיחא םכידגנכ וחנאת לא</verse>
        <verse osisID="Jas.5.10" n="10">ןודאה םשב םכל ורבדש םיאיבנהמ תוביסהו תורעצה לשמל םכל וחק םיבוהא םיחא</verse>
        <verse osisID="Jas.5.11" n="11">םיקיתמו םיחולמ םימ הב שיש ןייעמ שי יכו</verse>
        <verse osisID="Jas.5.12" n="12">ןה ןה היהת םכיתרוביד לבא העובש םושב וא ץראב אלו םימשב אל ועבשת לא םיבוחא םיחא לכ םדוקמ לבא ולשכת אלש ידכ אל אלו</verse>
        <verse osisID="Jas.5.13" n="13">ךירצ הז בל בוטב םכב דחא םאו ללפתל ךירצ אוה רבד הזיא לבוס םכב דחא םאורמזל םיליהת</verse>
        <verse osisID="Jas.5.14" n="14">ושעת םהו הדעהמ םיניקזה ול אורקל ךירצ הלוח דחא םאו ןידאה םשב ןמשב ותוא םיחשומו וליבשב הליפת <note type="footnote" n="33">This is a unique Hebrew marker word meaning “might, song, and pruning.” This word can be compared to the singing done by David when he sang for King Saul and the demons fled (2 Samuel 23:1). Zamar (רמז) is the power of God in the song.</note> </verse>
        <verse osisID="Jas.5.15" n="15">םיאטחה ול לוחמי אטחש םאו ותוא םוקי ןודאהו הלוחהל רוזעי הנומאהמ הליפתהו</verse>
        <verse osisID="Jas.5.16" n="16">והארקי רשא לכל ויארק לכל ה בורק יכ וריבח ליבשב הליפת השעי דחא לכו דחאל דחא םתאטח תא ודותהו</verse>
        <verse osisID="Jas.5.17" n="17">השלש ץראה לע םשג אב אלו םשג אבי אלש הליפת השעו ונומכ םדא היה איבנה והילא םגויצח םינש</verse>
        <verse osisID="Jas.5.18" n="18">הירפ תא ץראהו םמימ תא םימשה ןתנו םשג אביש הליפת השע ֜כ֜חאו ו</verse>
        <verse osisID="Jas.5.19" n="19">ערל בוטה ךרדמ ךלי םכב דחאש םאב םיחא ותוא ענומ דחאו</verse>
        <verse osisID="Jas.5.20" n="20">תונווע הברהל רפכמו תומהמ דחא המשנ ליצמ הז ותעשרמ ותוא ךפהמש ימ ועד</verse>
      </chapter>
    </div>
  </osisText>
</osis>
