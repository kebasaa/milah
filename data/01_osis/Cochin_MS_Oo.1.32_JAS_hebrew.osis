    <div type="book" osisID="Jas">
      <chapter osisID="Jas.1">
        <verse osisID="Jas.1.1" n="1">יעקב עבד ה ואדון יש֜ו֜ המשיח לשנים עשר שבטים המפזרים בכל המקומות שמחה מקודם</verse>
        <verse osisID="Jas.1.2" n="2">אחֵי אהובים תחשבו זאת ושמחה באם שאתם נֹופליםבנסיון</verse>
        <verse osisID="Jas.1.3" n="3">ודעו שאמונותיכם באם שהיאשלימה גורם היא סבלות</verse>
        <verse osisID="Jas.1.4" n="4">אבל סבלות צריך להיות עד הסוף כדי שתהיו במליאה ולא צלח תחסר שלם דבר ממכם</verse>
        <verse osisID="Jas.1.5" n="5">אבל באם שיש אחד בכם שחסר לו חכמה זה צריך להתפלל מה שנותן לכל אדם וגם הוא יתן לו</verse>
        <verse osisID="Jas.1.6" n="6">אבל הוא צריך להתפלל באמונה ולא בספק כי מי שמסופק זה הוא דומה למאזנים על הים</verse>
        <verse osisID="Jas.1.7" n="7">וזה האדם אינה צריך לחשב שיקבל איזה דבר מהאדון</verse>
        <verse osisID="Jas.1.8" n="8">וכעלמסופק הוא בלי ידע בכל־דרכיו</verse>
        <verse osisID="Jas.1.9" n="9">אבל אח אחד ששפל יוכל להתפאר את גבהו</verse>
        <verse osisID="Jas.1.10" n="10">והעושר צריך להתפאר את שפלתו כי כציץ שדה יבש</verse>
        <verse osisID="Jas.1.11" n="11">וכציץ יצא וימל ויברח כצל ולא יעמוד</verse>
        <verse osisID="Jas.1.12" n="12">ואשרי האנוש יוכיחנו אלוה ומוסר שדי אל תמאס כי אחר היסורים תקבל הכתר החיים שמבטיח ה֔ לאלה שאהוב אויי</verse>
        <verse osisID="Jas.1.13" n="13">ואל תאמר אחד באם שנסיון בא עליו זה בא מה כי ה לא מנסה או אדם לרע והוא אינה מנסה לשוםאחד</verse>
        <verse osisID="Jas.1.14" n="14">רק כל אחד ינסה באם שתאותו מנצח אותו</verse>
        <verse osisID="Jas.1.15" n="15">ואח֜ כ֜ באם שקבל התאוה גורם היא החטא אבל החטא באם שכלא גורם היא המות</verse>
        <verse osisID="Jas.1.16" n="16">אל תתעו אחים אהובים</verse>
        <verse osisID="Jas.1.17" n="17">כל מתנה טובה בא מלמעלה מאור האב ואצלו לא יש חילוף מאור ומחושך</verse>
        <verse osisID="Jas.1.18" n="18">והוא הראה לנו כפי רצונו ע״י דיבור האמת שאנו בכורים מבריאתו</verse>
        <verse osisID="Jas.1.19" n="19">בשביל זה אחים אהובים כל בני אדם צריך להיות מהיר לשמוע אבל לא לדבר ולא לאף</verse>
        <verse osisID="Jas.1.20" n="20">כי האף מבני אדם אינו עושה מה שטוב לפני ה֔</verse>
        <verse osisID="Jas.1.21" n="21"/>
        <verse osisID="Jas.1.22" n="22" alt:num="Jas.1.21">אבל תהיו מאילו שעושים הדיבור ולא מהשומעים לבד שבעצמו מרמאים אתכם</verse>
        <verse osisID="Jas.1.23" n="23" alt:num="Jas.1.22">כי באם שאחד יש השומע הדיבור לאינו עושה זה הוא דומה לאיש שרואה את עצמו במראות הצובאות</verse>
        <verse osisID="Jas.1.24" n="24" alt:num="Jas.1.23">כיון שאחר שראה את עצמו הולך הוא ממנו ושוכח את מה בראה</verse>
        <verse osisID="Jas.1.25" n="25" alt:num="Jas.1.24">אבל מי שרואה במלואה בדת השמחה ומקיים אותו ואינו שוכח מה ששמע רק עושה זה יהיה קדוש בכל מעשיו</verse>
        <verse osisID="Jas.1.26" n="26" alt:num="Jas.1.25">אבל באם שאחד בכם מחשב לו שהוא עובד ה לאינו משמר את לשונו ברסן רק הסית לבבו זה השאירות ה אינו טוב</verse>
        <verse osisID="Jas.1.27" n="27" alt:num="Jas.1.26">והשאירות הטהור מבלי חסרון לפני ה האב זה הוא ההולך לבצר היתומים ואת־אלמנות בצערותיהם</verse>
      </chapter>
      <chapter osisID="Jas.2">
        <verse osisID="Jas.2.1" n="1">אחים אהובים אל תחשבו שהאמונה בישו המשיח אדונינו שנושא פנים</verse>
        <verse osisID="Jas.2.2" n="2">כי באם שיבא אחד אצלהבית דיןבטבעת זהב ובמלבושים נעים וגם אחד עני במלבושים רעים׃</verse>
        <verse osisID="Jas.2.3" n="3">אתם רואים על זה שנושה המלבושים נעים ואומרים לו שב לנו על הטוב ואומרים לעני עמוד שם או שב לרגלינו</verse>
        <verse osisID="Jas.2.4" n="4">ואינם משגיחים בטוב על זה רק התם שופטים ותעשו חילוק רע</verse>
        <verse osisID="Jas.2.5" n="5">שומעים לי אחים אהובים הלא ה֔ בחר בעניים בעולם הזה־העושרים באמונה ויורשים מהבטחה שהבטיח לאלה שאהוב אותו</verse>
        <verse osisID="Jas.2.6" n="6">אבל אתם תעשו ביוש לעני והעשירים הלא המה שעושים הכל בחוזק עמכם ומוציאם אתכם ומשפט</verse>
        <verse osisID="Jas.2.7" n="7">והלא המה מחרפים ומגדפים השם הטוב מזה שאתם תקראו</verse>
        <verse osisID="Jas.2.8" n="8">באם שאתם תעשו הדת כפי שכתוב בתורה ואהבת לרעיך כמוך תעשו טוב</verse>
        <verse osisID="Jas.2.9" n="9">אבל באם שאתם רואים על האדם תעש וחטא ותענוש מדת כמו העוברים</verse>
        <verse osisID="Jas.2.10" n="10">כי באם שאחד מקיים כל התורה כולה וחוטא באחד הואחייבבכל</verse>
        <verse osisID="Jas.2.11" n="11">כי זה שאמר לא תנאף גם הלא אמר לא תרצח ובאם שאתה אינו מנאף אבל תעשה רציחה אתה עובר על הדת</verse>
        <verse osisID="Jas.2.12" n="12">כשכיל זה תדברו ותעשו כמו אלו שנשפטו ע״י הדת בשמחה</verse>
        <verse osisID="Jas.2.13" n="13">אבל יבא משפט רע על זה שלא עשה רחמים והרחמים מתפאר כצד המשפט</verse>
        <verse osisID="Jas.2.14" n="14">ומה תועלת יש אחים אהובים באם שאחד אמר שיש לו האמונה ולא יש לו המעשים ולהאמונה לא יש יכולת לקדש אותו</verse>
        <verse osisID="Jas.2.15" n="15" alt:num="Jas.2.15-Jas.2.16">ובאם שיש אחד אח או אחות שחסר להם לפרנס כל יום ויום ואחד מכם תאמר להם דברי נחמה ה יתן לכם לשובע והוא לא יתן להם שום דבר לתועלת הגופ מה תועלת יש להם בזה הדברים</verse>
        <verse osisID="Jas.2.16" n="16" alt:num="Jas.2.17">כך האמונה באם שלא יש לו המעשים</verse>
        <verse osisID="Jas.2.17" n="17" alt:num="Jas.2.18">אבל יוכל אחד לאמר לך יש האמונה ולי המעשים העיד לי אמונתך עם מעשיך גם אני מעיד לך אמונתי ומעשים שלי</verse>
        <verse osisID="Jas.2.18" n="18" alt:num="Jas.2.19">אתה תאמין שה אחד אתה עושה טוב השטנים גם כן מאמינים ורעדים</verse>
        <verse osisID="Jas.2.19" n="19" alt:num="Jas.2.20">אבל רוצה אתה לידע שהאמונה בלי מעשים מת הוא</verse>
        <verse osisID="Jas.2.20" n="20" alt:num="Jas.2.21">הלא אבותינו אברהם נצטדק ע מעשיו שהביא את בנו לקרבן על המזבח</verse>
        <verse osisID="Jas.2.21" n="21" alt:num="Jas.2.22">ובזה תוכל אתה לראות שהאמונה פעל במעשיו ועל יד המעשים נעשה האמונה במלואה</verse>
        <verse osisID="Jas.2.22" n="22" alt:num="Jas.2.23">ובזה ממלא התורה שנאמר ואברהם האמין בה ויחשבה לו צדקה</verse>
        <verse osisID="Jas.2.23" n="23" alt:num="Jas.2.24">ועגשיו יכולים אתם לראות שהאדם נצטדק על יד המעשים ולא לבד ע האמונה</verse>
        <verse osisID="Jas.2.24" n="24" alt:num="Jas.2.25">וכדומה לזה רחב הזונה הלא היא נצטדק ע המעשים כיון שלקחתה המרגלים ותטמנם</verse>
        <verse osisID="Jas.2.25" n="25" alt:num="Jas.2.26">כי כמו שהגוף בלי רוח הוא מת כך האמונה בלי מעשים הוא מת</verse>
      </chapter>
      <chapter osisID="Jas.3">
        <verse osisID="Jas.3.1" n="1">אחים אהובים אל תהיו כל אחד בעל מלמדודעו שהעונש יהיה יותר גדול</verse>
        <verse osisID="Jas.3.2" n="2">כי אנו חוטאים בהרבה דברים ומי שלא חטא בשום דבר הוא איש קדוש ויוכל לרסת את כל הגוף</verse>
        <verse osisID="Jas.3.3" n="3">וראה שאנו מנהגים את הסוסים ברסן כדי להנהיג אותם כרצונינו</verse>
        <verse osisID="Jas.3.4" n="4">וגם הספינות אע״פ שהמה גדולים והולכים בחוזק כרוח אע״פ כ״ מנהגים ע״י הגא קטנה שהיא ביד המלאך</verse>
        <verse osisID="Jas.3.5" n="5">כך הלשון היא איבר קטנה ופועלת דברים גדולים ראה אש קטן מבער יער גדול</verse>
        <verse osisID="Jas.3.6" n="6">וגם הלשון היא כמו אש עולם מלואה כעוולותכך הלשון באיברותינו ומחטיא את כל הגיפ ומבהיר אותנו בהליכתינו באם שהיא נבהר מגיהנם</verse>
        <verse osisID="Jas.3.7" n="7">כי הטבע מכל הבהמות והעופות והנחשים שהמה ביבשה או בים היא כמו הטבע של האדם</verse>
        <verse osisID="Jas.3.8" n="8">אבל הלשון לא יוכל שום אדם לרסת כי היא רע ומלואה בסם המות</verse>
        <verse osisID="Jas.3.9" n="9">ע״י הלשון משבחים אנו לה האב וע יז מקללים אנו להאדם שהוא בצלם אלהים</verse>
        <verse osisID="Jas.3.10" n="10">מפי אחד צא שבח וקללות ואל תהיה כך אחים אהובים</verse>
        <verse osisID="Jas.3.11" n="11">וכי יש מעיין שיש בה מים מלוחים ומתיקים</verse>
        <verse osisID="Jas.3.12" n="12">או יוכל עץ של תאניםליתןשמן או גפן תאנים כך המעיין לא יוכלליתןמים מלוחים ומתוקים</verse>
        <verse osisID="Jas.3.13" n="13">מי שהוא חכם ונבון בכם מראה לי הליכתו הטוב בחכמה</verse>
        <verse osisID="Jas.3.14" n="14">אבל באם שיש בלבבכם קנאה ושנאה אל תתפארו ואל תשקרו כעד האמת</verse>
        <verse osisID="Jas.3.15" n="15">כי זה אינו חכמה שבא מלמעלה רק מהאדמה מהאדם ומהשטנים</verse>
        <verse osisID="Jas.3.16" n="16">כי במי שיש קנאה ושנאה בזה יש הרבה דברים רעים</verse>
        <verse osisID="Jas.3.17" n="17">אבל החכמה מלמעלה היא להתחילה נקי ואח כ שלום ובנחת ויוכללפייסההמהיר לשמוע מלא רחמים ואחרית לטובה ולא משאוי פנים וחניפות</verse>
        <verse osisID="Jas.3.18" n="18">אבל הפירות מהצדקות נזרעת בשלום לאילה המקיימים השלום</verse>
      </chapter>
      <chapter osisID="Jas.4">
        <verse osisID="Jas.4.1" n="1">ובשביל מה בא מלחמה בתוכיכם הלא בשביל המדתיכם הלוחמים באיברותיכם</verse>
        <verse osisID="Jas.4.2" n="2">ואתם מתאויים ואינו מקבלים ונוקם ונוטר ואינו מרוויח בזה והכל בשביל מה מפני שאתם אינו מתפללים</verse>
        <verse osisID="Jas.4.3" n="3">ואתם עושים תפילה ולא נענה בשביל שאתם מתפללים ברעה</verse>
        <verse osisID="Jas.4.4" n="4">הנואף והנואפת הלא אתם יודעים שמי שאוהב עולם הזה הוא שונא מה ומי שרוצה להיות אוהב לעולם הזה יהיה שונא לה</verse>
        <verse osisID="Jas.4.5" n="5">אז אתם מחשבתם שהתורה אמר בחנם הרוח שדר בתויכם היא מתאוה כנגד הציוות ה</verse>
        <verse osisID="Jas.4.6" n="6">ונותן הרבה חסד כיון שהתורה אמר שה מגביה את השפלים ומשפיל את הרמים</verse>
        <verse osisID="Jas.4.7" n="7">ועכשיו תהיו מוכנעים לה ותלחמו כנגד השטנים תברחו ממכם</verse>
        <verse osisID="Jas.4.8" n="8">ומקרבים אתכם לה וקרב הוא לכם ותטהרו את ידיכם החוטאים ותעשו לבבכם נקי</verse>
        <verse osisID="Jas.4.9" n="9">ותנשאו סבלות ובכו ותצוקיכם תתהפך לבכיה ושמחתיכם ליגון</verse>
        <verse osisID="Jas.4.10" n="10">מכניעים אתכם לפני ה ישמע הוא לכם</verse>
        <verse osisID="Jas.4.11" n="11">אחים אהובים אל תלכורכילבניכם כי מי שהולך רכיל באחיו הוא רכיל בדת ואם אתה תעשה כן אין אתה מקיים את הדת</verse>
        <verse osisID="Jas.4.12" n="12">ויש לבד אחר שנותן הדת שיוכל לענוש ולמחול אבל מי אתה לשפוט את האחרים</verse>
        <verse osisID="Jas.4.13" n="13">ועכשיו האם שאתם אומרים היום או מחר רוצים אנולילךלמקים או לעיר הזאת ורוצים אנו לעמוד שם אחד שנה ולעשות משא ומתן</verse>
        <verse osisID="Jas.4.14" n="14">ואתם לא יודעים מה שיוכל להיות למחר כי מה יש חייותיכם הלא רוח הוא לזמן מועט ואחר כך הוא הולך</verse>
        <verse osisID="Jas.4.15" n="15">ואנו ואתם צריכים לומר באם שירצה ה חיים רוצים אנו לעשות זאת</verse>
        <verse osisID="Jas.4.16" n="16">אבל עכשיו אתם מתפארים בגאותיכםוזאת היא לרעה</verse>
        <verse osisID="Jas.4.17" n="17">כי מי שיודע לעשות טוב ואינה עושה לזה נחשב לחטא</verse>
      </chapter>
      <chapter osisID="Jas.5">
        <verse osisID="Jas.5.1" n="1">ועכשיו העשירים צעקו ובכו על הרעה שיבא עליכם</verse>
        <verse osisID="Jas.5.2" n="2">עשירתיכם רקב ושמלתיכם היתה למאכל כעש</verse>
        <verse osisID="Jas.5.3" n="3">וכספיכם וזהביכם יחלוד וזה יהיה לכם לעדות ויאכל את בשרכם כמו אש ואתם תקבלו עשירות באחרית הימים</verse>
        <verse osisID="Jas.5.4" n="4">ראה פעולת שכיר שתלין אצליך צועק לפני וצעקותיהם בא לפני אזנים מהאדון צבאות</verse>
        <verse osisID="Jas.5.5" n="5">והיה לכם תאוות עולם הזה ושמחו לקול עוגב</verse>
        <verse osisID="Jas.5.6" n="6">ואתם מחייבים להצדק ותמיתו אותו והוא לאמיחהלכם</verse>
        <verse osisID="Jas.5.7" n="7">ועכשיו אחים אהובים תהיה לכם תקוה על העתיד מהאדון ראה בעל השדה מצפה על הפירות הארץ ותקותו הוא על היורה ומלקוש</verse>
        <verse osisID="Jas.5.8" n="8">ואף אתם חזקו חזקו לבבכם כי שעתיד מהאדון קרובה</verse>
        <verse osisID="Jas.5.9" n="9">אל תאנחו כנגדיכם אחים אחובים כדי שלא תבואו לידי תקלה כי השופט עומד לפני הפתח</verse>
        <verse osisID="Jas.5.10" n="10">אחים אהובים קחו לכם למשל הצערות והסיבות מהנביאים שדברו לכם בשם האדון</verse>
        <verse osisID="Jas.5.11" n="11">וכי יש מעיין שיש בה מים מלוחים ומתיקים</verse>
        <verse osisID="Jas.5.12" n="12">אבל מקודם כל אחים אחובים אל תשבעו לא בשמים ולא בארץ או בשום שבועה אבל דיבורתיכם תהיה הן הן ולא לא כדי שלא תכשלו</verse>
        <verse osisID="Jas.5.13" n="13">ואם אחד בכם סובל איזה דבר הוא צריך לתפלל ואם אחד בכם בטוב לב זה צריךלזמרתהילים</verse>
        <verse osisID="Jas.5.14" n="14">ואם אחד חולה צריך לקרוא לו הזקינים מהעדה והם תעשו תפילה בשבילו ומושחים אותו בשמן בשם האדין</verse>
        <verse osisID="Jas.5.15" n="15">והתפילה מהאמונה יעזור להחולה והאדון יקום אותו ואם שחטא ימחול לו החטאים</verse>
        <verse osisID="Jas.5.16" n="16">והתודו את חטאתם אחד לאחד וכל אחד יעשה תפילה בשביל חבירו כי קרוב ה לכל קראיו לכל אשר יקראהו באמת</verse>
        <verse osisID="Jas.5.17" n="17">וגם אליהו הנביא היה אדם כמונו ועשה תפילה שלא יבא גשם ולא בא גשם על הארץ שלשה שנים חצי</verse>
        <verse osisID="Jas.5.18" n="18">ו ואח֜כ֜ עשה תפילה שיבא גשם ונתן השמים את מימם והארץ את פריה</verse>
        <verse osisID="Jas.5.19" n="19">אחים באם שאחד בכם ילך מדרך הטוב לרע ואחד מונע אותו</verse>
        <verse osisID="Jas.5.20" n="20">דעו מי שמהפך אותו מרשעתו זה מציל נשמה אחד מהמות ומכפר להרבה עוונות</verse>
      </chapter>
    </div>
  </osisText>
</osis>
