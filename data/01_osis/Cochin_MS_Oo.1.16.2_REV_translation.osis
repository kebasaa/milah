<osis xmlns="http://www.bibletechnologies.net/2003/OSIS/namespace" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:alt="https://projecttruthministries.org/studies/cochin-revelation/" xsi:schemaLocation="http://www.bibletechnologies.net/2003/OSIS/namespace http://www.bibletechnologies.net/osisCore.2.1.1.xsd">
  <osisText osisIDWork="MS.Oo.1.16.2_REV_PTM" osisRefWork="bible" xml:lang="en">
