      <work osisWork="MS.Oo.1.16.2">
        <title>Revelation (Cochin MS Oo.1.16.2)</title>
        <scope>REV</scope>
        <type type="x-manuscript">Manuscript</type>
        <identifier type="shelfmark">MS.Oo.1.16.2</identifier>
        <identifier type="URI">https://projecttruthministries.org/studies/cochin-revelation/</identifier>
        <publisher>Project Truth Ministries</publisher>
        <contributor role="scr" file-as="Rahabi, Ezekiel">Rabbi Ezekiel Raḥabi</contributor>
        <date event="original" type="ISO">ca. 1730</date>
        <description>The Cochin Hebrew New Testament manuscripts are significant 18th-century Hebrew versions of the New Testament currently housed at Cambridge. Digitized version of the MS Oo.1.16.2 can be found on the NLI website.</description>
      </work>
    </header>
    <div type="book" osisID="Rev">
      <chapter osisID="Rev.1">
        <verse osisID="Rev.1.1" n="1">י֞ע םתוא חלש אוהו בורקב היהיש המ וידבעל תוארהל חישמה 18ו֞שיל ֞ה ןתנ תודוסה הלא סיננהאי ודבעל ולש ךאלמ</verse>
        <verse osisID="Rev.1.2" n="2">׃הארש הממ חישמה ושימ תודעהו ֞ה רובידה דעה</verse>
        <verse osisID="Rev.1.3" n="3">׃בותכש המ םימייקמו תואיבנה תאז םיעמושהו ארוקה אוה שודק</verse>
        <verse osisID="Rev.1.4" n="4">תוחור העבשהמו היהיו הוהו היהש הזמ םכמע היהי םולשו דסח איסאב םיניקז העבשהו סיננהאי ׃ואסכמ המהש</verse>
        <verse osisID="Rev.1.5" n="5">ונתצחרו ונתבהאה ץראה לע הוצמו דיגנו םיתמהמ םקש ןושארו ןמאנ דעה חישמה ו֜֜שימו ׃ומד םע וניתונוועמ</verse>
        <verse osisID="Rev.1.6" n="6">׃ןמא םלוע דעו םלועמ תראפתו דובכ היהת ול ויבאו ֞ח ינפל םינהכלו םיכלמל ונתוא השעו</verse>
        <verse osisID="Rev.1.7" n="7">׃ןמא ןכ ץראה תוחפשמה לכ וכביו ותוא םירקודה הלא ותוא וארתו ןנעב אבי אוה הֵאר</verse>
        <verse osisID="Rev.1.8" n="8">:היהיו הוהו היהה רידא ןודאה רמא ףוסהו תליחת ןורחאהו ןושארה אוה ינא</verse>
        <verse osisID="Rev.1.9" n="9">:חישמה ושימ תודעהו ֞ה רובידה ליבשב סמטפ ארקנה יאב יתייה סיננאהי ינא</verse>
        <verse osisID="Rev.1.10" n="10">׃לודג לוק ירחאמ ינעמשו שדוקה חור ילע הרושו</verse>
        <verse osisID="Rev.1.11" n="11">סוזיהפעלו איסאב םיניקזהל ותוא חלשו רפסב בותכ תיארש המ לכו ןורחאהו ןושארה ינא הרמאו :ןַאֶציִדָּׁאלו ןאַיפְלֶדַליִפְל םגו סדִראַזלו סַריִטַאיִטְל םגו סומיגריפלו ןונרימסל םגו</verse>
        <verse osisID="Rev.1.12" n="12">׃בהז לש תורונמ עבש יתיאר יתכפהשכו ימיע תרבודה לוקה תא תוארל יתכפהו</verse>
        <verse osisID="Rev.1.13" n="13">:בהז לש רגחב הזחה לע רוגחו ןבל תונותכב שובלו םדא תומדכ דחא םהינבו</verse>
        <verse osisID="Rev.1.14" n="14">׃שא תבהלכ ויניעו ןבל רמצכ ןבל היה ורעשו ושאר לבא</verse>
        <verse osisID="Rev.1.15" n="15">׃םילודג םימ שערכ ולוקו תשוחנכ וילגרו</verse>
        <verse osisID="Rev.1.16" n="16">׃שמשכ חרז והארמו תויפיפ ברח ךלה ויפמו ונימי דיב םיבכוכ העבשו</verse>
        <verse osisID="Rev.1.17" n="17">ןושארה ינא ארית לא יל רמאו ילע ונימי די תא חינה אוהו תמכ וילגרל יתלפנ ותוא יתיארשכו ׃ןורחאהו</verse>
        <verse osisID="Rev.1.18" n="18">׃םנהיגהו תומה לש תוחתפמה שי םלוע ילו םלועמ ינא יח וישכעו תמ יתייה ינא הֵארו</verse>
        <verse osisID="Rev.1.19" n="19">׃ךכ רחא היהיש המו תיארש המ בותכ</verse>
        <verse osisID="Rev.1.20" n="20">הלא םיבכוכ העבשה אוה ךכ בהז לש תורונמ עבשו ינימי דיב תיארש םיבכוכ העבשהמ דוסהו :םיניקז העבש תורונמ העבשהו םיכאלמ העבש המה</verse>
      </chapter>
      <chapter osisID="Rev.2">
        <verse osisID="Rev.2.1" n="1">ךותב ךלוהה םיבכוכ העבשה ונימי דיב שיש הז רמא הכ בותכ םוזיהפע לש הדעהמ ךאלמהלו ׃בהז לש תורונמ העבשה</verse>
        <verse osisID="Rev.2.2" n="2">המהש םירמואה וליאל הסנתו םיעשרה תא לובסל לכות אל תאו ךיתוקתו ךישעמ תא עדוי ינא ׃םינבזכ המהש אצמתו םניאו םיאיבנ</verse>
        <verse osisID="Rev.2.3" n="3">׃ימש ליבשב לכה שי ךיתחרטו ךיתוקתו</verse>
        <verse osisID="Rev.2.4" n="4">׃הנושאר הבהאה התא בוזעת המ ינפמ יל הימת לבא</verse>
        <verse osisID="Rev.2.5" n="5">ומוקממ ךיתרונמ ףחדי הרהמב ואל םאבו םינושארה ךישעמ ישעו הבושת ישעו התא ימ רוכז :הבושת השעת אלש םאב</verse>
        <verse osisID="Rev.2.6" n="6"/>
        <verse osisID="Rev.2.7" n="7" alt:num="Rev.2.6">:ןדע ןגב שיש םייחה ץעמ לכאי חצנמש ימ הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
        <verse osisID="Rev.2.8" n="8" alt:num="Rev.2.7">׃םקו תמה ןורחאהו ןושארה רמא הכ בותכ ןינר֞ימז לש הדעהמ ךאלמהלו</verse>
        <verse osisID="Rev.2.9" n="9" alt:num="Rev.2.8">:ןתטשה ינבמ המה קר םניאו םידוהי םהש םירמואה ולאמ ףוריחהו ךיתורעצו ךישעמ עדוי ינא</verse>
        <verse osisID="Rev.2.10" n="10" alt:num="Rev.2.9">םימי הרשע םכל היהי רעצהו םכתא תוסנל ידכ היבשב םהמ הזיא חקי ןטשה הֵאר םהמ ארית לא ׃םייחהמ רתכה ךל ןתאש ידכ ךתומ םוי דע ןמאנ יהת</verse>
        <verse osisID="Rev.2.11" n="11" alt:num="Rev.2.10">:תרחא תוממ רעצ ול היהת לא חצנמש ימ הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
        <verse osisID="Rev.2.12" n="12" alt:num="Rev.2.11">:תויפיפ ברח ול שיש הז רמא הכ בותכ םומיגריפ לש הדעהמ ךאלמהלו</verse>
        <verse osisID="Rev.2.13" n="13" alt:num="Rev.2.12">יתיעבו יתנומאבו ימשב ןימאת התאו ןטשה אסכ שיש םוקמב שי ךלש םוקמו ךישעמ תא עדוי ינא :רד ןטשהש םוקמב םכילצא סַפיִטְנַא ןמאנה יריבח תא גרה</verse>
        <verse osisID="Rev.2.14" n="14" alt:num="Rev.2.13">םתוא אוטחל לארשי ינבל ער תושעל קלב י֞ע םעלב לש דומילב םידמולש וליאמ אנוש התא םגו</verse>
        <verse osisID="Rev.2.15" n="15" alt:num="Rev.2.14">׃וליאמ אנוש ינא ףאו ןאיִצְטַלָּׁאקיִנ דומילמ אנוש התא םגו</verse>
        <verse osisID="Rev.2.16" n="16" alt:num="Rev.2.15">:יפב שיש ברחה י֞ע המחלמ ךמע תושעל הרהמב ינא אבא ואל םאו הבושת ישע</verse>
        <verse osisID="Rev.2.17" n="17" alt:num="Rev.2.16">ןמהמ לכאל ול ןתיל ינא הצור חצנמש ימ הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ לביקש הז קר אורקל דחא םוש לכוי אלש בותכ שדְח םש תודעה הזבו הבוט תודע םגו רתסנה</verse>
        <verse osisID="Rev.2.18" n="18" alt:num="Rev.2.17">תשוחנכ וילגרו שא תבהל ומכ המה ויניעש ֞ה ןב רמא הכ בותכ אריטאיט לש הדעהמ ךאלמלו</verse>
        <verse osisID="Rev.2.19" n="19" alt:num="Rev.2.18">:רתוי השענ תע לוכבו ךיתוקתו ךיתנומאו ךיתיראשו ךיתבהאו ךישעמ תא עדוי ינא</verse>
        <verse osisID="Rev.2.20" n="20" alt:num="Rev.2.19">תא םיתיסמו םידמולו האיבנ איהש תרמואה לֶבאַזֶי השאה בוזעתש ךילע יל שי ןטק רבד לבא :תונז תושעל ידבע</verse>
        <verse osisID="Rev.2.21" n="21"/>
        <verse osisID="Rev.2.22" n="22" alt:num="Rev.2.20">:םהישעמ לע הבושת ושעת אלש םאב רעצ הברה המע בכשש הז לעו הילע איבמ ינא האר</verse>
        <verse osisID="Rev.2.21" n="21" alt:num="Rev.2.21">:הבושת תושעל תע הל יתתנ ינאו</verse>
        <verse osisID="Rev.2.23" n="23" alt:num="Rev.2.22">׃ול םלושי ויתודמ יפכ דחא לכו בלו תוילכ ןחובה אוה ינאש וריכת הדעה לכו ותמוי הינב תאו</verse>
        <verse osisID="Rev.2.24" n="24" alt:num="Rev.2.23">ודמלת אלש ןויכ רעצ דוע םכילע איבא אלש ינא רמוא אריטאיטב המהה םירחאלו םכל לבא ׃ןטשה דומילמ</verse>
        <verse osisID="Rev.2.25" n="25" alt:num="Rev.2.24">׃אבאש דע םכל שיש הזב וקזחת לבא</verse>
        <verse osisID="Rev.2.28" n="28"/>
        <verse osisID="Rev.2.29" n="29" alt:num="Rev.2.28">:הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
      </chapter>
      <chapter osisID="Rev.3">
        <verse osisID="Rev.3.1" n="1">תא עדוי ינא םיבכוכ העבשהו ֞ה תוחורה ול שיש הז רמא הכ בותכ ןיִדְראַז לש הדעהמ ךאלמהלו :תמ התאו יח התאש ךל שי םש יכ ךישעמ</verse>
        <verse osisID="Rev.3.2" n="2">׃֞ה ינפל המילש ךישעמ תא יתאצמ אל יכ תומל הצורש הזל קזחתו ןשית לא ןכל</verse>
        <verse osisID="Rev.3.3" n="3">בנגכ ךילע ינא אבא ואל םאו הבושת ישעו םתוא םייקמו תעמשו תלבקש ךאיה רוכז וישכעו :אבאש ןמז הזיאב עדוי הניא התאו</verse>
        <verse osisID="Rev.3.4" n="4">םיואר המה יכ םיניבל םידגבב ימיע וכלת המהו םהידגב תא ופנט אלש ןי֞דראזב עמשנ ךמש םגו</verse>
        <verse osisID="Rev.3.5" n="5">ינפל ומש תא עידומ ינאו םייחה רפסמ ומש תא החמא אל ינאו םיניבל םידגבב ךלת חצנמש ימו :ויכאלמ ינפלו יבא</verse>
        <verse osisID="Rev.3.6" n="6">:הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
        <verse osisID="Rev.3.7" n="7">דוד לש חתפמה ול שיש הז ןמאנהו שודקה רמא הכ בותכ איְַפלעֶדאַליִפ לש הדעהמ ךאלמהלו ׃חותפל לכוי דחא םושו רוגסמה ריגסל לכוי דחא םושו חתופה</verse>
        <verse osisID="Rev.3.8" n="8">ךל שי חכ טעמ יכ םתוא רוגסל לכוי דחא םוש חותפ חתפ ךינפל יתתנ הֵאר ךישעמ תא עדוי ינא :ימשב רפוכ ךניאו ירבד תא תרמשו</verse>
        <verse osisID="Rev.3.9" n="9">ינאש הֵאר םיבזוכ קר םניאו םידוהי המהש םירמואה ןטשה תתורבחמ המהש וליאל ןתא ינא הֵאר :ךתוא יתבהאש ריכהלו ךילגרל ללפתל ואובת המהש תושעל הצור</verse>
        <verse osisID="Rev.3.10" n="10">וליאל תוסנל ץראה לע אבה ןויסנה לש תעהמ ךתוא רומשא ינא ךכ יתוקתמ רובידה תרמשש ןויכ ׃ץראה לע םירדה</verse>
        <verse osisID="Rev.3.11" n="11">׃ךירתכ תא דחא םוש חקי אלש ידכ ךל שיש המ רומש הרהמב אבא ינא האר</verse>
        <verse osisID="Rev.3.12" n="12">ץראהל םימשהמ אביש יהלא ריעה שדחה םילשורימ םשהו יהלאמ םשה וילע בותכא חצנמש ימ ׃שדחה ימש םגו יהלאמ</verse>
        <verse osisID="Rev.3.13" n="13">׃הדעהל רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
        <verse osisID="Rev.3.14" n="14">׃תואירבהמ הלחתה ןמאנ דעה ןמא רמא הכ בותכ ַאֶציִדָּׁאַל הדעהמ ךאלמלו</verse>
        <verse osisID="Rev.3.15" n="15">׃םח וא רק היהתש ילוא םח אלו רק אל התאש ךישעמ תא עדוי ינא</verse>
        <verse osisID="Rev.3.16" n="16">׃יפמ ךתוא ינא קרי הז ליבשב םח אלו רק אל התאש ןוכ לבא</verse>
        <verse osisID="Rev.3.17" n="17">׃ןויבאו ינע התאש עדוי ךניא לבא רבד םושל ךרוצ הניאו יד יל שיו רשוע ינא רמאת התאו</verse>
        <verse osisID="Rev.3.18" n="18">ידכ ןמשב ךיניע תא תחשמו םינבל םישובלמ שובלתו ינממ בהז הנקתש ךל יתצע ןתונ ינאו ׃תוארל לכותש</verse>
        <verse osisID="Rev.3.19" n="19">הבושת הֵשע וישכעו יתבהאש וליאל רסומ ינאו141׃</verse>
        <verse osisID="Rev.3.20" n="20">חתפיו ילוק תא עמשי דחאש םאבו הב קפדו חתפה ינפל דמוע ינא הארחתפה ׃ךליא הזל</verse>
        <verse osisID="Rev.3.21" n="21">׃ואסכ לע יבא םע יתבשיו יתחצנש ומכ יאסכ לע ימיע בשיל ןתא הזל חצנמש ימ</verse>
        <verse osisID="Rev.3.22" n="22">׃רמוא חורהש המ עמוש םינזא ול שיש ימ</verse>
      </chapter>
      <chapter osisID="Rev.4">
        <verse osisID="Rev.4.1" n="1">רפוש לוקכ ימיע תרבדמה יתעמשש ןושארה לוקהו םימשב דחא חתפ חתפנש יתיאר ךכ רחאו :ךכ רחא היהיש המ ךל תוארהל הצור ינאו ןאכל אב יל רמא</verse>
        <verse osisID="Rev.4.2" n="2">:דחא בשי אסכה לעו םימשב בשי דחא אסכ יתיארו שדוקה חור ילע הרוש דימו ףכיתו</verse>
        <verse osisID="Rev.4.3" n="3">:ךפנ ומכ תשק דחא היה אסכהל ביבסו הפשיו ריפס ןבא הארמכ והיארמ היה וילע בשיהו</verse>
        <verse osisID="Rev.4.4" n="4">םישובלמב שובל םיניקז םירשעו עברא םיבשוי םהילעו םיאסכ םירשעו עברא היה אסכהל ביבסו :בהז רתכ םהישאר לעו םיניבל</verse>
        <verse osisID="Rev.4.5" n="5">תוחור העבש המה וליאו אסכה ינפל תורינ העבשו םיקרבו םימערו תולוק אצי אסכהמו ֞ה :</verse>
        <verse osisID="Rev.4.6" n="6">אלמ תויח עברא אסכהל ביבסו אסכה ךותבו המלחא תומדכ תיחולצ לש דחא םי היה אסכה ינפלו :םהירחאמו םהינפלמ םיניע</verse>
        <verse osisID="Rev.4.7" n="7">תומדכ היה ןושארה היחהוחדכ149 הירא :רשנכ יעיברהו םדאכ ישילשהו רושכ הינשהו</verse>
        <verse osisID="Rev.4.8" n="8">דימת םירמואו הלילו םוי החונמ םהל שי אלו םיניע םע םיאולמ םינפבמו םיפנכ שש דחא לכלו שודק שודק שודק ֞ה :היהיו הוהו היהה רידאה תואבצ</verse>
        <verse osisID="Rev.4.9" n="9">:םלוע דעו םלועמ יחכו אסכה לע בשיש הזל האדוהו חבש םינתונ תויחהש העשבו</verse>
        <verse osisID="Rev.4.10" n="10">םהירתכ םיקרוזו םלוע דעו םלועמ יחש הזל םיללפתמו וינפל םיניקז םירשעו עבראה םילפונ ויה :םירמואו וינפל Hebrew Transcription</verse>
        <verse osisID="Rev.4.11" n="11">:לכה השענ ךנוצר ל֞עו לוכה ארב התא יכ תראפתו דובכ חקיל היואר התא ןודא</verse>
      </chapter>
      <chapter osisID="Rev.5">
        <verse osisID="Rev.5.1" n="1">׃תומיתח עבשב ץוחבמו םינפבמ תומיתחב םותחו דחא רפס ונימי דיב יתיאר אסכה לע בשיש הזו</verse>
        <verse osisID="Rev.5.2" n="2">׃ויתומיתח רבשלו רפסה תא חותפל היואר ימ לודג לוקב קעז דחא ךאלמ יתיארו</verse>
        <verse osisID="Rev.5.3" n="3">׃וב תוארלו רפסה חותפל לכוי ץראבו םימשב אל דחא םושו</verse>
        <verse osisID="Rev.5.4" n="4">׃רבדה הזל היוארש דחא אצמנ אלש ןויכ דואמ ינא הכובו</verse>
        <verse osisID="Rev.5.5" n="5">חותפל דוד שרושהמ אדוי יתחפשממ שיה היראה חצנש האר הכבת לא יל רמא םינקזהמ דחאו ׃תומיתח העבשה רבשלו רפסה</verse>
        <verse osisID="Rev.5.6" n="6">העבש היה ולו גרהנש ומכ דחא הש דמע םיניקז םירשעו עבראהו תויחהו אסכה ךותבש יתיארו ֞ה תוחור העבשה וליאו םיניע העבשו םינרק ׃ץראה לכב חלשנ</verse>
        <verse osisID="Rev.5.7" n="7">׃אסכה לע בשיש הזמ ונימי דימ רפסה חקלו אבו</verse>
        <verse osisID="Rev.5.8" n="8">רוניכ םהידיבו השה ינפל םיניקז םירשעו עבראו תויח עבראה םילפונ ויה רפסה חקלש העשבו ׃םישודקה תליפת איה תאזו תרוטק םיאלמ תותחמו</verse>
        <verse osisID="Rev.5.9" n="9">ונתוא תינקו גרהנ התא יכ ויתומיתח תא חותפלו רפסה חקיל היואר התא ורמאו שדח ריש ורמזו</verse>
        <verse osisID="Rev.5.10" n="10">׃ץראה לע םיכלמ ויהנ ונחנאו םיכלמלו םינהכל ונתוא תישעו</verse>
        <verse osisID="Rev.5.11" n="11">׃תובבר םיפלא היה םרפסמו אסכהל ביבס םיכאלמהמ הברה תולוק יתעמשו יתיאר</verse>
        <verse osisID="Rev.5.12" n="12">׃תליהתלו תראפתלו דובכלו חכל היואר גרהנה השה לודג לוקב םירמואו</verse>
        <verse osisID="Rev.5.13" n="13">אסכה לע בשויה הזל םירמואש יתעמש םיבו ץראה תחתמו ץראה לעו םימשב שיה תואירבה לוכו :םלוע דעו םלועמ חבשו תוליהתו דובכ השהלו</verse>
        <verse osisID="Rev.5.14" n="14">׃םלוע דעו םלועמ יחש הזל םיללפתמו םילפונ םיניקז םירשעו עבראו ןמא םינוע תויחה עבראו</verse>
      </chapter>
      <chapter osisID="Rev.6">
        <verse osisID="Rev.6.1" n="1">׃הארו אב דחא לוקכ םירמוא תויח עבראהש יתעמשו תומיתחמ דחא חתפ השהש יתיארו</verse>
        <verse osisID="Rev.6.2" n="2">׃חצנו חצנל ךלה אוהו דחא רתכ ןתונ ולו דחא תשק ודיב היה וילע בשויהו ןבל דחא סוס יתיארו</verse>
        <verse osisID="Rev.6.3" n="3">׃הארו אב רמא הינשה היחש יתעמש ינשה תומיתח חתפנש ןויכו</verse>
        <verse osisID="Rev.6.4" n="4">׃לודג ברח ןתונ ולו ץראהמ םולשה חקיל ןתונ וילע בשויהו םדא רחא סוס ץוחל ךלהו</verse>
        <verse osisID="Rev.6.5" n="5">וילע בשויהו רחש דחא סוס יתיארו הארו אב ישילשה היחה רמא ישילשה תמיתח חתפש העשבו ׃דחא םינזאמ ודיב היה</verse>
        <verse osisID="Rev.6.6" n="6">םירועש תודמ השולשו םינפ ינשב םיטיח תחא הדמ רמא תויח עבראה ךותב דחא לוק יתעמשו ׃ער השעת לא ןייהו ןמשהלו םינפ ינשב</verse>
        <verse osisID="Rev.6.7" n="7">׃הארו אב רמוא יעיברה היחה יתעמש יעיברה תמיתח חתפש ןויכו</verse>
        <verse osisID="Rev.6.8" n="8">ןתונ ולו וירחא ךלה םנהיגהו תומה ךאלמ ומש היה וילע בשיש הזו ץמאו דרב דחא סוס יתיארו ׃ץראה תויח י֞עו תומבו בערבו ברחב ץראה לע יעיבר קלח תימהל תושר</verse>
        <verse osisID="Rev.6.9" n="9">היהש תודעה ליבשבו םשה תשודק לע וגרהנש תומשנה לכיהה תחת יתיאר ישימחה חתפש ןויכו</verse>
        <verse osisID="Rev.6.10" n="10">וליאמ ונימד םקנת הניאו טופשת יתמ דע ןמאנהו שודקה ןודא םירמואו לודג לוקב םיקעוצו ׃ץראה לע םירדה</verse>
        <verse osisID="Rev.6.11" n="11">׃טעומ ןמז דוע וטקשתש םהל רמאנו ןבל ישובלמ ןתונ םהמ דחא לכלו</verse>
        <verse osisID="Rev.6.12" n="12">׃םדכ םדֻא היה חריהו רוחש היה שמשהו ץראה תודער היהו ישישה חתפש יתיארו</verse>
        <verse osisID="Rev.6.13" n="13">׃הנאתמ תלבנכו ןפגמ הלע לבנכ לובי םאבצ לכו</verse>
        <verse osisID="Rev.6.14" n="14">׃םמוקממ וזעדנ תועבגו םירהה לכו</verse>
        <verse osisID="Rev.6.15" n="15">תולחמבו םירצ תורעמב םירתוס םישפוחהו םידבעהו םירטושהו םירישעהו םינזורו ץרא יכלמו</verse>
        <verse osisID="Rev.6.16" n="16">ינפמו אסכה לע בשויה הז לש הארמה ינפמ ונתוא רתוסו ונילע לופנ םיעלסלו םירההל םירמואו ׃השה ןורח</verse>
        <verse osisID="Rev.6.17" n="17">׃וינפל דומעל לכוי ימו אב ופא ןורחמ םויה יכ</verse>
      </chapter>
      <chapter osisID="Rev.7">
        <verse osisID="Rev.7.1" n="1">תוחור עבראה םדיב םיזחואו ץראה תוניפ עברא לע םידמוע םיכאלמ עברא יתיאר ךכ רחאו ׃ץע םוש לעו םימה לעו ץראה לע חור היהת אלש ידכ ץראה</verse>
        <verse osisID="Rev.7.2" n="2">עבראהל לודג לוקב קעצו םייקו יח לאהמ םתוחה היה ולו שמשה חרזממ אבש רחא ךאלמ יתיארו ׃םיהו ץראה קיזהל םהל ןתונה םיכאלמ</verse>
        <verse osisID="Rev.7.3" n="3">׃֞ה ירבע תוחצמ לע וָּׁת ןתאש דע ץעל וא םיהלו ץראהל וקיזת לא רמאו</verse>
        <verse osisID="Rev.7.4" n="4">ינב תוחפשממ ומתחנש םיפלא םיעבראו עבראו האמ היה ומתחנש וליאמ רפסמה יתעמשו</verse>
        <verse osisID="Rev.7.5" n="5">׃ףלא רשע םינש דג טבשמו ףלא רשע םינש ןבואר טבשמ ףלא רשע םינש אדוהי טבשמ</verse>
        <verse osisID="Rev.7.6" n="6">׃ףלא רשע םינש השנמ טבשמ ףלא רשע םינש ילתפנ טבשמ ףלא רשע םינש רשא טבשמ</verse>
        <verse osisID="Rev.7.7" n="7">׃ףלא רשע םינש רכששי טבשמו ףלא רשע םינש יול טבשמ ףלא רשע םינש ןועמש טבשמ</verse>
        <verse osisID="Rev.7.8" n="8">׃ףלא רשע םינש ןימינב טבשמו ףלא רשע םינש ףסוי טבשמו ףלא רשע םינש ןלובז טבשמ</verse>
        <verse osisID="Rev.7.9" n="9">השה ינפלו אסכה ינפל םידמוע םימעה לכמ רופסל לכוי אלש הלודג התורבה יתיאר ךכ רחאו :םיפנע םהידיבו םיניבל םישובלמב םישבולו</verse>
        <verse osisID="Rev.7.10" n="10">םירמואו לודג לוקב םיקעוצו ֞הל ׃השהלו העושיה</verse>
        <verse osisID="Rev.7.11" n="11">םיללפתמו אסכה ינפל םהינפ לע םילפונו תויחהו םיניקזהו אסכהל ביבס םידמוע םיכאלמה לכו</verse>
        <verse osisID="Rev.7.12" n="12">׃ןמא םלוע דעו םלועמ וניהלאל היהת הרובגו חכו תראפתו דובכו תוליהתו האדוהו חבש םירמואו</verse>
        <verse osisID="Rev.7.13" n="13">:המה םיאב םוקמ הזיאמו םיניבל םישבלמב םישבולה וליא ימ יל רמאו םיניקזהמ דחא ןעיו</verse>
        <verse osisID="Rev.7.14" n="14">וקקזו םהידגב וצחרו רעצ הברה ךותמ םיאבה המה וליא יל רמא אוהו עדוי התא ןודא ול יתרמאו ׃השה םדב םהידגב</verse>
        <verse osisID="Rev.7.15" n="15">׃םהילע רודת אסכה לע בשיש הזו הלילו םוי ותוא ותרשו ֞ה אסכה ינפל המה הז ליבשבו</verse>
        <verse osisID="Rev.7.16" n="16">׃שמשו ברש םכי אלו ואמצי אלו ובערי אל איהו</verse>
        <verse osisID="Rev.7.17" n="17">׃םינפ לכ לעמ העמד םיהלא ֞ה החמו םימ ראבל םתוא םגהני השה יכ</verse>
      </chapter>
      <chapter osisID="Rev.8">
        <verse osisID="Rev.8.1" n="1">׃אדח העשכ םימשב םלוכ םיקתוש יעיבשה חתפש ןויכו</verse>
        <verse osisID="Rev.8.2" n="2">׃תורפוש העבש ןתונ םהלו ֞ה ינפל םיאב םיכאלמ העבש יתיארו</verse>
        <verse osisID="Rev.8.3" n="3">תליפתל ןתיל תרוטק הברה ןתונ ולו בהז לש תותחמ ודיבו לכיהה לצא ךְַרַדְו אב רחא ךאלמו ׃אסכה ינפלו לכיהה ינפל םישודקה</verse>
        <verse osisID="Rev.8.4" n="4">֞ה ינפל ךאלמה דימ ךלה םישודקה תרטקהמ ןשעהו ׃</verse>
        <verse osisID="Rev.8.5" n="5">׃םיקרבו םימערו תולוק אבו ץראה לע קציו שאב ותוא אלמו התחמה חקל ךאלמהו</verse>
        <verse osisID="Rev.8.6" n="6">׃עוקתל םינכומ ויה תורפוש העבשה םע םיכאלמ העבשהו</verse>
        <verse osisID="Rev.8.7" n="7">קרי לכו ףרשנ םיצעהמ שילשו ץראה לע לפנו םדב ללב שאו דרב היהו עקות ןושארה ךאלמהו ׃ףרשנ הדשה</verse>
        <verse osisID="Rev.8.8" n="8">׃םד היה םיה שילשו םיב ךלהו שאב ףרש לודג רהכ היהו עקות ינשהו</verse>
        <verse osisID="Rev.8.9" n="9">םיעבשינ תוניפסמ שילשו םיתמי םיה תואירבמ שילשו ׃</verse>
        <verse osisID="Rev.8.10" n="10">׃םימ תוראבה שילש לע לפנו ףרשו םימשמ דחא בכוכ לפנו עקות ישילשהו</verse>
        <verse osisID="Rev.8.11" n="11">׃םהיררומ ינפמ םימה י֞ע םיתמ םדא ינב הברהו רמ היה םימה שילשו תעלת היה בכוכה םשו</verse>
        <verse osisID="Rev.8.12" n="12">׃הלילה םגו חרז אל םויהמ שילשו םיבכוכו חריהו שמשהמ שילשה הקלנו עקות יעיברהו</verse>
        <verse osisID="Rev.8.13" n="13">ץראה לע םירדה וליאל יוא יוא יוא לודג לוקב קעצו םימשב ףחר דחא ךאלמ יתעמשו יתיארו ׃םיכאלמ השולשה עוקתל דוע םיכירצש תרפושה לוקה ינפמ</verse>
      </chapter>
      <chapter osisID="Rev.9">
        <verse osisID="Rev.9.1" n="1">:םוהתמ חתפמה ןתונ ולו םימשמ ץראה לע לפנ דחא בכוכ יתיארו עקות ישימחה ךאלמהו</verse>
        <verse osisID="Rev.9.2" n="2">:םוהתה ןשעמ ריואהו שמשה ךשחהו לודג רונתמ ןשע ומכ םוהתמ ןשע אציו םוהתה חתפו</verse>
        <verse osisID="Rev.9.3" n="3">םיאב ןשעהמו םיעדרפצ תושר ןתונ םהלו ץראה לעתולכל :תיחשהל</verse>
        <verse osisID="Rev.9.4" n="4">תמיתחה םהל שי אלש םדא ינבל דבל קר ץעל וא הדשה בשעלו קריל וקיזת אלש םהל רמאֶנו :֞המ םהיחצמב</verse>
        <verse osisID="Rev.9.5" n="5">םאב םיברקע רעצכ היה םהירעצו םישדח השמח םתוא רעצל קר םתוא תימהל אל ןתונ םהלו</verse>
        <verse osisID="Rev.9.6" n="6">:ונאצמת אלו תומל ומכחת המהה םימיבו</verse>
        <verse osisID="Rev.9.7" n="7">םהיארמו םיבהז ירתכ תומדכ םהישאר לעו המחלמל םינכומה םיסוסה ומכ המה ם֞יהבראו :םדאה תוארמכ</verse>
        <verse osisID="Rev.9.8" n="8">:הירא ינשכ וינשו םישנה תורעשכ םהיתורעשו</verse>
        <verse osisID="Rev.9.9" n="9"/>
        <verse osisID="Rev.9.10" n="10" alt:num="Rev.9.9">:םישדח השמח םדא ינבה רעצל תושר ןתונ םהלו הֵברא יבנזכ היה םהיבנזו</verse>
        <verse osisID="Rev.9.11" n="11" alt:num="Rev.9.10">:ןָּׁאיִלְלָּׁפַא ןוי ןושלבו ןודבא ירבע ןושלב ומשו םוהתמ דחא ךאלמ היה םהלש ךלמו</verse>
        <verse osisID="Rev.9.12" n="12" alt:num="Rev.9.11">:םיאב םיבעכ ינש דוע האר ךלה בעכ דחא</verse>
        <verse osisID="Rev.9.13" n="13" alt:num="Rev.9.12">: ֞ה ינפל לכיהה תוניפ עבראמ דחא לוק יתעמשו עקת ישישה ךאלמהו</verse>
        <verse osisID="Rev.9.14" n="14" alt:num="Rev.9.13">ארקנה לודגה םיה לצא םירוסאה םיכאלמ עבראהל שפחו ךל עקתש ישישה ךאלמהל תרמואו</verse>
        <verse osisID="Rev.9.15" n="15" alt:num="Rev.9.14">:דחא הנשבו שדוחבו םויבו העשב םדא ינבמ שילשה תימהל םינכומ יוה םיכאלמ עבראהו</verse>
        <verse osisID="Rev.9.16" n="16" alt:num="Rev.9.15">:םרפסה יתעמשו יפלא םיתבר םרפסמ היה םהיבכרו</verse>
        <verse osisID="Rev.9.17" n="17" alt:num="Rev.9.16">שאו תרפגו תפז לש םישובלמ םהל היהש םהילע םיבשויהו םיסוסה תרוצב יתיאר ךכ רחאו :תירפגו ןשעו שא ךלה םהיפמו היראה ישארכ םיסוסה ישארו</verse>
        <verse osisID="Rev.9.18" n="18" alt:num="Rev.9.17">:םדא ינבמ שילשה גרהנ השולשה וליאמו</verse>
        <verse osisID="Rev.9.19" n="19" alt:num="Rev.9.18">:םתוא םיגרוה וליאבו םהל היה םישארו םישחנכ היה םהיבנזו םהיפב היה םחוכ יכ</verse>
        <verse osisID="Rev.9.20" n="20" alt:num="Rev.9.19">םהישעמ לע הבושת ושעש ליבשב םיעגנה וליא י֞ע ותמוי אלש םדא ינב הברה דוע היה לבא םהב שי אלש בהזו ףסכו ץעמ וא ןבאמו סרחמ השענה הרז ֜ז֜על אלו ןטשהל םיללפתמ אלו םיערה ׃עומשל וא רבדל או ךליל תלוכי</verse>
        <verse osisID="Rev.9.21" n="21" alt:num="Rev.9.20">:םהיתבינג לע וא םהיתונז לעו םהיפשכ לע הבושת ושע אלשו</verse>
      </chapter>
      <chapter osisID="Rev.10">
        <verse osisID="Rev.10.1" n="1">תבהלכ וילגרו שמשכ והיארמו ושאר לע תשקו רחא ןנעב שובלו םימשמ דרי רחא ךאלמ יתיארו</verse>
        <verse osisID="Rev.10.2" n="2">׃השביה לע ולאמש םעו םיה לע ונימי לגר םע ךרדו חותפ דחא רפס ודיבו</verse>
        <verse osisID="Rev.10.3" n="3">׃םהילוקב תולוק העבש םירבדמ קעצש העשבו היראה קעצכ לודג לוקב קעצו</verse>
        <verse osisID="Rev.10.4" n="4">לאו םתוא רוגס יל תרמואה םימשמ לוק תב יתעמש םתוא בותכל יתיצר םהילוקב ורבדש רחאו</verse>
        <verse osisID="Rev.10.5" n="5">׃םימשה לא ולאמשו ונימי םרי יתיארש השביה לעו םיה לע דמועה ךאלמהו</verse>
        <verse osisID="Rev.10.6" n="6">׃תע דוע שי אלש םהב שיש המ לכו םיהו ץראהו הב שיש המו םימשה ארבה םלועה יחב עבשיו</verse>
        <verse osisID="Rev.10.7" n="7">וידבעל עידומש ומכ ֞ה תודוסה הלא לכ הנילכת תורפושב םיעקות םיכאלמ העבשהש םאב קר ׃ויאיבנלו</verse>
        <verse osisID="Rev.10.8" n="8">׃השביה לעו םיה לע דמועה ךאלמה דימ חותפה רפסה חקו ךֵל יל רמא לוק תב םעפ דוע יתעמשו</verse>
        <verse osisID="Rev.10.9" n="9">ךיפב שבדכ ךל היהיו התוא עלובו חק יל רמא אוהו רפסה יל ונת ול יתרמאו ךאלמהל יתכלהו ׃רעצ ךל השעי ךיעמב לבא</verse>
        <verse osisID="Rev.10.10" n="10">׃יעמב רעצ יל השע יתלכאש רחאו יפב שבדכ היהו ותוא יתעלובו ךאלמה דימ רפסה יתחקלו</verse>
        <verse osisID="Rev.10.11" n="11">:םיכלמלו םימעלו םימואל םעפ דוע אבינל ךירצ התא יל רמא אוהו</verse>
      </chapter>
      <chapter osisID="Rev.11">
        <verse osisID="Rev.11.1" n="1">:וב םיללפתמה וליאו וחבזמו ֞ה לכיהה דודמל םוק רמאו הטמ תומדכ דחא הנק יל ןתונו</verse>
        <verse osisID="Rev.11.2" n="2">םינש םיעברא שדוקה ריעה וכרדי םימעהל ןתונ אוה יכ דומת אלו ץוחל קורז ימינפה לכיהה לבא :םישדח</verse>
        <verse osisID="Rev.11.3" n="3">:םיקשב שובלו םוי םישישו תואמ ינשו ףלא םיאבנמ םהו ילש םידע ינש תא ןתונ ינאו</verse>
        <verse osisID="Rev.11.4" n="4">:ץראה יהלא ינפל םידמוע תוקובא ינשו םיתיז ינש המה הלאו</verse>
        <verse osisID="Rev.11.5" n="5">:םתוא ףרשו שא אובת הער םהל תושעל הצור דחאש םאו</verse>
        <verse osisID="Rev.11.6" n="6">םדב ךפהל םימה לעו םהיאבנ ימיב ץראה לע םשג אבי אלש םימשה רוגסל תושר שי םהלו :וצריש תע לכב םיעגנב ץראה תוכהלו</verse>
        <verse osisID="Rev.11.7" n="7">:םתוא גרהיו םתוא חצניו םמיע המחלמ םוהתמ ךלהש היחה השעי םתודע אלכש רחאו</verse>
        <verse osisID="Rev.11.8" n="8">םירצמו םודס ארקנה השודקה ריעהמ תובוחרה לע וקרזת םהיתלבנוןויכ בלצנ םשש םוקמה םגו</verse>
        <verse osisID="Rev.11.9" n="9">׃םתוא ורבקת אלו יצחו םימי השולש םהיתלבנ תא וארי םיטבשהמו םימעהמ הזיאו</verse>
        <verse osisID="Rev.11.10" n="10">הברה ושע וללה םיאיבנה יכ והערל שיא תונתמ וחלשיו םהילע וחמשי ץראה לע םירדה וליאו :ץראה לע םירדה וליאל רעצ</verse>
        <verse osisID="Rev.11.11" n="11">םיאורה וליא לע לפנ הלודג המיאו דחפו םהילגר לע םיסרודו המה ומוקי יצחו םימי השולש רחאו</verse>
        <verse osisID="Rev.11.12" n="12">:םהיאנוש םתוא וארו דחא ןנעב םימשב הלעמל ולעיו ולע םהל רמא דחא לוק םיעמושו</verse>
        <verse osisID="Rev.11.13" n="13">םירחאו םדא ינבמ םיפלא העבש תמיו לפנ ריעהמ ירישע קלחו צראה תודער היה תאזה העשבו :םימשה יהלאל חבש ונתנו ולהבנ</verse>
        <verse osisID="Rev.11.14" n="14">:אב ישילשהו ךלה הינשה רעצה האר</verse>
        <verse osisID="Rev.11.15" n="15" alt:num="Rev.12.1">םלוכ םיכלוה הזה םלועהמ םירישה םירמואה םימשב הברה תולוק ויהו עקת יעיבשה ךאלמהו ׃םלוע דעו םלועמ לשמי אוהו ו֞שי ונינודא רחא</verse>
        <verse osisID="Rev.11.16" n="16" alt:num="Rev.12.2">ינפל םהיאסכ לע םיבשויה םינקז םירשעו עבראו ֞ה ֞הל םיללפתמו םהינפ לע םילפונ ׃</verse>
        <verse osisID="Rev.11.17" n="17" alt:num="Rev.12.3">׃היהיו הוהו היהה תואבצ ןודא ךל חבש םינתונ ונא םירמואו</verse>
        <verse osisID="Rev.11.18" n="18" alt:num="Rev.12.4">םיאיבנה ךידבעל רכשה ןתילו םיתמה טופשל תעהו ךפא אבו המיחו ףא ואלמתנ םימעהו ׃ץראה ותיחשהש וליאל תיחשהלו םילודגלו םינטקל ךינפמ םיאריה וליאלו םישודקלו</verse>
        <verse osisID="Rev.11.19" n="19" alt:num="Rev.12.5">םימערו תולוק היהו ותליפת תיבב תירבה תוחול ןורא הארתנו םימשב חתפנ ֞ה תליפת תיבו ׃לודג דרבו ץראה תודערו םיקרבו</verse>
      </chapter>
      <chapter osisID="Rev.12">
        <verse osisID="Rev.12.1" n="1" alt:num="Rev.12.6">ןמ דחא רתכ השאר לעו הילגר תחת חריהו שמשב שבל השא דחא םימשב לודג םג הארתנו ׃םיבכוכ רשע םיינש</verse>
        <verse osisID="Rev.12.2" n="2" alt:num="Rev.12.7">׃הדילה ליבשב רעצ הברה הל היהו רבשמה לע תבשוי איהו תקעוצו תרבועמ היה איהו</verse>
        <verse osisID="Rev.12.3" n="3" alt:num="Rev.12.8">העבש וישאר לעו םינרק הרשעו םישאר העבש היה ולו ןינת דחא יתיארו םימשב היה רחא סנו</verse>
        <verse osisID="Rev.12.4" n="4" alt:num="Rev.12.9">לוכאל ידכ דליתש השאה ינפל ךרד ןינתהו ץראה לע םתוא קרזו םיבכוכהמ שילש חקל ובנזו ׃דלונש םאב דליה</verse>
        <verse osisID="Rev.12.5" n="5" alt:num="Rev.12.10">׃ואסכו ֞ה ינפל אבומ דליהו לזרב טבשב םימעה גהנמה דחא ןב הדליו</verse>
        <verse osisID="Rev.12.6" n="6" alt:num="Rev.12.11">תואמ ינשו ףלא םש התוא סנרפל ֞המ דחא םוקמ םש הל ןכומ היהש ןויכ רבדמב הכלה השאהו ׃םוי םיששו</verse>
        <verse osisID="Rev.12.7" n="7" alt:num="Rev.12.12">׃םמיע ומחל ויכאלמו ןינתה םע ומחלנ ויכאלמ םע לאכימ ךאלמה םימשב המחלמ השענו</verse>
        <verse osisID="Rev.12.8" n="8" alt:num="Rev.12.13">׃םימשב םמוקמ תא דוע אצמנ אל םגו וחצנ אלו</verse>
        <verse osisID="Rev.12.9" n="9" alt:num="Rev.12.14">םיכלשנ ויכאלמ םע אוהו םלועה לכ תא תיסמהו תיחשמה ןטשה ארקנה לודגה ןינתה ץוחל ךלשנו ׃םש רודל ץראה לע</verse>
        <verse osisID="Rev.12.10" n="10" alt:num="Rev.12.15a">הז ץוחל ךלשנש ןויכ וחישמו וניהלא תורובג הארתנ וישכע רמאש םימשב לודג לוק יתעמשו ׃םהילע ןטשל תע לכ היהש</verse>
        <verse osisID="Rev.12.11" n="11" alt:num="Rev.12.15b">ותוא וחצניו י֞ע השה םד י֞עו ׃םולכל םהייח תא ובשחו םהיתודעמ רובידה</verse>
        <verse osisID="Rev.12.12" n="12" alt:num="Rev.12.16">םכל דרי ןטשה יכ םיה לעו ץראה לע םירדה וליאל יואו הב רשא לכו םימשה וחמשת הז ליבשבו ׃טעומ ןמז ול שיש עדויו לודג ףא ןורחב</verse>
        <verse osisID="Rev.12.13" n="13" alt:num="Rev.12.17">׃הדליש השאה רחא ףדר ץראה לע ךלשנש ןינתה הארש ןויכו</verse>
        <verse osisID="Rev.12.14" n="14" alt:num="Rev.12.18a">תע םש התוא סנרפל ֞ה הל ןתנש םוקמב רבדמב ךליל ידכ לודג רשנכ םיפנכ יתש השאהל ןתונו :ןינתה ינפמ יצחו םיתיע ינשו דחא</verse>
        <verse osisID="Rev.12.15" n="15" alt:num="Rev.12.18b">׃התוא טיקשהל ידכ לודג םיכ היפמ םימ השאה רחא ןינתה ךילשהו</verse>
        <verse osisID="Rev.12.16" n="16" alt:num="Rev.12.19">׃הירחא ןינתה ךילשהש םימה עלבו היפ תא החתפש ןויכ המדאהמ העושי השאהל היה לבא</verse>
        <verse osisID="Rev.12.17" n="17" alt:num="Rev.12.20">ףאב אלמתנ ןינתהו לע350 ֞ה תוצמ תא םישועה הערזמ םירתונה םע םוחלל ךלהו השאה תודוא ׃וחישמ לש תודעב םינימאמהו</verse>
      </chapter>
      <chapter osisID="Rev.13">
        <verse osisID="Rev.13.1a" n="1a" alt:num="Rev.13.1">:םיה לוח לע יתכרדו</verse>
        <verse osisID="Rev.13.1b" n="1b" alt:num="Rev.13.2">לעו םירתכ הרשע וינרק לעו םינרק הרשעו םישאר העבש היה ולו םיהמ אצי דחא היח יתיארו :םיפודגו םיפוריח לש תומש הישאר</verse>
        <verse osisID="Rev.13.2" n="2" alt:num="Rev.13.3">ואסכו וחכ תא ול ןתנ ןינתהו היראה יפכ ויפו םיבוד ילגרכ וילגרו סוס תומדכ היה יתיארש היחהו :הלודג תרובגו</verse>
        <verse osisID="Rev.13.3" n="3" alt:num="Rev.13.4">היחה ליבשב םמותשמ םלועה לכו האפרתנ הרובחו תומ לש הרובחל המוד וישארמ דחא יתיארו</verse>
        <verse osisID="Rev.13.4" n="4" alt:num="Rev.13.5">ימו היחה תאזל המוד ימ םירמוא היחהל םיללפתמו הלשממו חכ היחהל ןתונה ןינתהל םיללפתמו :ומיע םוחלל לכוי</verse>
        <verse osisID="Rev.13.5" n="5" alt:num="Rev.13.6">םינשו םיעבראה לש ןמזה אלכש דע ףוריחו תואלפנ ירבד רבדל ויפ תא חותפל היחהל ןתונו</verse>
        <verse osisID="Rev.13.6" n="6" alt:num="Rev.13.7">:םימשב םירדה דגנכו ֞ה דגנכ ףרחל ויפ תא חתפו</verse>
        <verse osisID="Rev.13.7" n="7" alt:num="Rev.13.8">:םימואו םימעה לכו םתוא חצנלו םישודקה םע םוחלל ול ןתונו</verse>
        <verse osisID="Rev.13.8" n="8" alt:num="Rev.13.9">גרהנה השה לש םייחה רפסב םמש תא בתכנ אלש וליא ול םיללפתמ ץראה לע םירדה םלוכו :םלועה תאירב תליחתמ</verse>
        <verse osisID="Rev.13.9" n="9" alt:num="Rev.13.10">:עמוש םינזא ול שיש ימ</verse>
        <verse osisID="Rev.13.10" n="10" alt:num="Rev.13.11">שי ןאכבו ברחב גרהי ברחב דחא שפנ גרה דחאש םאבו רמשמב ךלי רמשמב גהני דחאש םאב :םישודקה תנומאו הוקת</verse>
        <verse osisID="Rev.13.11" n="11" alt:num="Rev.13.12">:ןינתכ רבדמו השהל ומכ םינרק יתש היה ולו המדאהמ אצי רחא היח תיארו</verse>
        <verse osisID="Rev.13.12" n="12" alt:num="Rev.13.13">היחהל םיללפתמ הילע םירדהו המדאהש השעו הנושארה היחה ינפל תולודג תואלפנ השעו :היתרובח האפרתנש הנושארה</verse>
        <verse osisID="Rev.13.13" n="13" alt:num="Rev.13.14">:םדאה ינפל םימשמ שא לפנש השעו</verse>
        <verse osisID="Rev.13.14" n="14" alt:num="Rev.13.15">שיש היחהל לספ ושעיש ךראה לע םירדה וליאל רמאו ולש םיתפומו תותוא םע םדא ינבה תיסהו :האפרתנו ברח תורובח הל</verse>
        <verse osisID="Rev.13.15" n="15" alt:num="Rev.13.16">ידכ שפנו חור היחה לספל ןתיל ןתונ ולו לבויש לספל ללפתהל הצרי אלש ימ תושעלו רבדל :גרהיש היחהמ</verse>
        <verse osisID="Rev.13.16" n="16" alt:num="Rev.13.17">וא ונימי דיב דחא ןמיס םיררחושמהו םידבעה םיינעהו םירישעה םינטקחו םלודגה םלוכל השעו :םהיחצמב</verse>
        <verse osisID="Rev.13.17" n="17" alt:num="Rev.13.18">לש םשה וא וחצמב וא ודיב ןמיסה הז ול שיש םאב קר רוכמל וא תונקל דחא םוש לכוי אלש ידכ :ומש לש רפסמה וא היחה</verse>
        <verse osisID="Rev.13.18" n="18" alt:num="Rev.13.19">דחא םדא לש רפסמ איה יכ היחהמ רפסמה בשחל ךירצ לכש לעב םיש ימ הנובתו המכח שי ןאכב :הששו םיששו תואמ שש איה ךסה אצמתו</verse>
      </chapter>
      <chapter osisID="Rev.14">
        <verse osisID="Rev.14.1" n="1">לש םשה בתכנ םהילעו םיפלא םיעבראו עבראו האמ ומעו ןויצ רה לע דמע דחא הש יתיארו</verse>
        <verse osisID="Rev.14.2" n="2">לוקכ היה יתעמשש לוקהו םילודג תולוק לוקכו םילודג םימ שערכ םימשמ דחא לוק יתעמשו</verse>
        <verse osisID="Rev.14.3" n="3">רישה דומלל לכוי דחא םושו םיניקזהו תויח עבראה ינפלו אסכה ילנפל שדח רישב םירמזמו :המדאהמ הנקש םיפלא םיעבראו עבראו האמה וליא קר תאזה</verse>
        <verse osisID="Rev.14.4" n="4">תרוכבל םינקנ המהו השה רחא םיכלוהו תולותבכ םהו םישנב ואטח אלש המה ולאו ֞ה השהו:</verse>
        <verse osisID="Rev.14.5" n="5">: ֞ה אסכה ינפל םייקנ םהו הימר םחורב ןיאו</verse>
        <verse osisID="Rev.14.6" n="6">דחא היה ולו םימשה עצמאב ףחר דחא ךאלמ יתיארו ץראה לע םירדה ולואל עידוהל ןויליג ןוא :םימואלו םימעה לכלו</verse>
        <verse osisID="Rev.14.7" n="7">םימשה ארבש הזל הליפת ושעו אב ןידה םויה יכ ול םכתליפת ושעו ֞ה וארי לודג לוקב רמאו :תוראבהו םיהו ץראהו</verse>
        <verse osisID="Rev.14.8" n="8">לש ןייה םע טיקשה איה יכ הלודגה ריעה לבב הלפנ הלפנ קעצו רחא ךאלמ אב לוקה הז רחאו ׃םימעה לכל התונז</verse>
        <verse osisID="Rev.14.9" n="9">חקיו היחהלו לספהל ותליפת השעי דחאש םאב לוג לוקב רמאו ישילשה ךאלמ אב הז רחאו :וחצמ לע וא ודי לע ןמיסה</verse>
        <verse osisID="Rev.14.10" n="10">:השהו םישודקה ויכאלמ ינפל תירפגו שאב שנעיו ןורחה סוכב שיה ֞ה ןורחלש ןייהמ התשי הז</verse>
        <verse osisID="Rev.14.11" n="11">וחקלש וליא הלילו םוי החונמ םהל היהי אלו םלוע דעו םלועמ הלעמל ךלי םהלש שנועמ ןשעהו :לספל םיללפתמו ןמיסה</verse>
        <verse osisID="Rev.14.12" n="12">:ושיב םינימאמו ֞ה תוצמ םישועה שי ןאכבו םישודקמ הוקת שי ןאכב</verse>
        <verse osisID="Rev.14.13" n="13">איה תמאו וישכעמ םשה שודיק לע םיתמה המה םישודק בותכ יל רמא םימשמ לוק תב יתעמשו :םהירחא םיכלוה םהישעמ יכ םהישעממ םינכוש המהש רמא חורהש</verse>
        <verse osisID="Rev.14.14" n="14">:דחא שמרח ודיבו בהז רתכ ושאר לעו םדא תומדכ דחא בשי וילעו ןבל דחא ןנע יתיארוו</verse>
        <verse osisID="Rev.14.15" n="15">יכ רצקו ךלש שמרחב ךה ןנעה לע בשיש הזל לודג לוקב קעצו הליפתה תיבמ ךלה רחא ךאלמו :אב הריצקה תעה</verse>
        <verse osisID="Rev.14.16" n="16">:רצקו ולש שמרחב הכה ןנעה לע בשיש הזו</verse>
        <verse osisID="Rev.14.17" n="17">:דחא לגעמ היה ודיבו םימשל ךלה רחא ךאלמו</verse>
        <verse osisID="Rev.14.18" n="18">ךה רמאו לגמה ול היהש הזל לודג לוקב קעצו שאה לע הלשממ היה ולו חבזמהמ אצי רחא ךאלמו רצקו ךלש לגמב ץרא יבנע תא רצקו ולש לגמב ךאלמה ךיו :לשבנת היתוריפ יכ ץרא יבנע תא : ֞ה ןורחה לודג בקיב קרזו</verse>
      </chapter>
      <chapter osisID="Rev.15">
        <verse osisID="Rev.15.1" n="1">העבשה היה םהלו םיאב םיכאלמ העבש יכ םימשב םילודג תואלפנו םיסינ יתיארוכמ םיעגנ אלכ םהב יכ םינורחאה ןורחה425 ֞המ ףא ןורסה ׃</verse>
        <verse osisID="Rev.15.2" n="2">תיחולצה םיה לצא םידמוע ולש לספו היחה םע וחצנש־וליאו שא םע ללב תיחולצ םי ומכ יתיארו ׃֞ה תורוניכ היה םהלו</verse>
        <verse osisID="Rev.15.3" n="3">ךיכרד תמאו קדצ תואבצה יהלא ֞ה ישעמ הלודג םירמואו השה רישהו השמ לש הרישה םירמזמו ׃םיכלמה ךלמ</verse>
        <verse osisID="Rev.15.4" n="4">יכ ךינפל וחתשיו ואובי םימעה לכ יכ שודק ודבל התא יכ ךמשל חבש ןתילו ךינפל הארי אל ימו הלגתנ ךיטפשמ ׃</verse>
        <verse osisID="Rev.15.5" n="5">׃םימשב תירבה ןורא חתפנש יתיאר ךכ רחאו</verse>
        <verse osisID="Rev.15.6" n="6">לע בהז לש רוגחו םיניבל ישובלמב שובלו םיעגנ העבשה םהל היהש םיכאלמ העבשה ץוחל אציו</verse>
        <verse osisID="Rev.15.7" n="7">דעו םלועמ יחה ֞ה ןורחב םיאלמ בהז לש תורעק עבש םיכאלמ העבשהל ןתנ תויח עבראהמ דחאו</verse>
        <verse osisID="Rev.15.8" n="8">אלכש דע הכותל ךליל לכוי דחא םושו ןכשמה תא אלמ ֞ה דובכו ןשעב האלמתנ הליפתה תיבו ׃םיכאלמ העבשהמ םיעגנ העבשה</verse>
      </chapter>
      <chapter osisID="Rev.16">
        <verse osisID="Rev.16.1" n="1">וקאצי וכל םיכאלמ העבשהל רחאו הליפתה תיבמ דחא לוק יתעמשו450 המדאה לע תורעקהמ ׃֞ה ןורחה</verse>
        <verse osisID="Rev.16.2" n="2">היחהמ ןמיסה םהל היהש םדאה לע חרפ ןיחשל היהו המדאה לע ורעק תא קציו ךלה ןושארהו ׃ולש לספל םיללפתמהו</verse>
        <verse osisID="Rev.16.3" n="3">תממ ומכ םד היהו םיב ורעק תא ינשה ךאלמה קציו458 ׃תומת םיהב רשא לכו</verse>
        <verse osisID="Rev.16.4" n="4">׃םד היהו םימ תוראבב ורעק תא קצי ישילשהו</verse>
        <verse osisID="Rev.16.5" n="5">׃טפשמה תאז תתנש התא שודקו הוהו היהה קידצה ֞ה רמא ךאלמהש יתעמשו</verse>
        <verse osisID="Rev.16.6" n="6">׃הזל םיואר המה יכ תותשל םד םהל תתנ התאו םימכ םיאיבנהו םישודקה ימד וכפש המה יכ</verse>
        <verse osisID="Rev.16.7" n="7">׃המה קדצ ךיטפשמ תואבצה יהלא ןכ לכיהה ךותמ רבידש רחא ךאלמ יתעמשו</verse>
        <verse osisID="Rev.16.8" n="8">׃םדאל םח תושעל ןתונ ולו שמשב ורעק תא קצי יעיברהו</verse>
        <verse osisID="Rev.16.9" n="9">וללה םיעגנה ליבשב ֞הל וללקמו םדאל םח הברה היהו ֞הל ׃דובכ ול ןתיל הבושת ושע</verse>
        <verse osisID="Rev.16.10" n="10">׃רעצ ינפמ םהינושל םיכשונ המהו ותוא ךשחהו היחה לש אסכה לע ורעק תא קצי ישימחהו</verse>
        <verse osisID="Rev.16.11" n="11"/>
        <verse osisID="Rev.16.12" n="12" alt:num="Rev.16.11">חרזממ המהש םיכלמהל הלפמ תויהל ידכ רהנה תא שביו סֶטַרְפֵא רהנה לע ורעק תא קצי יששהו</verse>
        <verse osisID="Rev.16.13" n="13" alt:num="Rev.16.12">׃םיעדרפצ תומדכ םיאמט םיצרש השולש רקש איבנה יפמו היחה יפמו ןינתה יפמ ךלהש יתיארו</verse>
        <verse osisID="Rev.16.14" n="14" alt:num="Rev.16.13">םתוא ץבקל םלועה לכלו ץרא יכלמל םיכלוהו תותואו םיסינ םישועו ןטשה תוחור המה וליאו ׃רידאה ֞ה םויה לע המחלמל</verse>
        <verse osisID="Rev.16.15" n="15" alt:num="Rev.16.14">ידכ םישובלמ ילב םורע ךלי אלש ומצע תא רומשו םינישי אלש וליא שודקו בנגכ אבא ינא האר ׃ותוורע תא הלגי אלש</verse>
        <verse osisID="Rev.16.16" n="16" alt:num="Rev.16.15">׃ןָּׁדֶגַמַרַה ירבע ןושלב ארקנש ארקנה דחא םוקמב םתוא ץבק אוהו</verse>
        <verse osisID="Rev.16.17" n="17" alt:num="Rev.16.16">׃רבע תאז רמאו אסכהמ דחא לוק ךלהו ריואב ורעק תא קצי יעיבשהו</verse>
        <verse osisID="Rev.16.18" n="18" alt:num="Rev.16.17">׃םלועמ היה אלש ץראה תודערו םיקרבו םימערו תולוק היהו</verse>
        <verse osisID="Rev.16.19" n="19" alt:num="Rev.16.18">ינפל לבב הלודגה ריעה רכזנו םילפונ םימעהמ םירעהו םיקלח השלש השענ הלודגה ריעהמו ֞ה ׃ופא ןורח לש ןייה םע סוכה הל ןתיל</verse>
        <verse osisID="Rev.16.20" n="20" alt:num="Rev.16.19">׃דוע וארנ אלו וסנ תועבגו םירהה לכו</verse>
        <verse osisID="Rev.16.21" n="21" alt:num="Rev.16.20">םיפרחמ המהו םימשמ םדאה לע לפנ לודג דרבו ֞הל ׃דרבה לש עגנה ליבשב</verse>
      </chapter>
      <chapter osisID="Rev.17">
        <verse osisID="Rev.17.1" n="1">לש טפשמה ךל הארהו אב רמאו יל רבדו תורעק העבשה םהל היהש םיכאלמ העבשהמ רחא אבו ׃הברה םימ לע תבשויה הלודגה הנוזה</verse>
        <verse osisID="Rev.17.2" n="2">׃הניימ תרכשמה וליאו ץרא יכלמ תונז םישוע המעו</verse>
        <verse osisID="Rev.17.3" n="3">היה אלמו םינשוש הארמכ היה והיארמש היחה לע הבשיש השאה יתיארו רבדמב יתוא איבהו ׃םינרק הרשעו םישאר עבש היה ולו םיפוריח לש תומשב</verse>
        <verse osisID="Rev.17.4" n="4">תוילגרמו תובוט םינבאו בהז הברה היה הילעו םינשוש הארמכ םודא ישובלמב שובל היה השאהו ׃תואמט אלמ הדיב בהז לש סוכו</verse>
        <verse osisID="Rev.17.5" n="5">׃ץראה תואמוטמו תונוזהמ םאה לבב הלודגה ריעהמ דוסה לש םשה בותכ היה החצמבו</verse>
        <verse osisID="Rev.17.6" n="6">׃התוא הארשכ יל היה הלודג הימתו ושי לש תודעה םדמו םישודקה םדמ התש השאהש יתיארו</verse>
        <verse osisID="Rev.17.7" n="7">הילע הבשיש היחהמו השאהמ דוסה ךל רמאל הצור ינא הימת ךל שי המ ינפמ יל רמא ךאלמהו ׃םינרק הרשעו םישאר עבש ול שיש המ ינפמו</verse>
        <verse osisID="Rev.17.8" n="8">םאב המדאה ישנא הילע םמותשיו לואשל ןליו םוהתמ םעפ דוע אביו הוה אלו היה תיארש היחה ׃שיש י֜פ֜עא שי אלו היהש היחה ואריש</verse>
        <verse osisID="Rev.17.9" n="9">הילע בשוי השאהש םירה העבש המה םישאר העבשה הנובתו המכחו לכש ךירצש רבד שי ןאכבו ׃םיכאלמ העבש המה וליאו</verse>
        <verse osisID="Rev.17.10" n="10">׃טעומ ןמז תויהל אוה ךירצ אביש םאבו שי אל ןיידע ינשהו שי דחאו השמח לפנ םהמו</verse>
        <verse osisID="Rev.17.11" n="11">׃לואשל ךלהו העבשהמ שי אוהו ינימשה הז שי אלד היהש היחהו</verse>
        <verse osisID="Rev.17.12" n="12">םיכלמכ ולשמת המה לבא תוכלמה ולבק אל ןיידעש םיכאלמ הרשע םה תיארש םינרק הרשעהו ׃טעומ ןמז לע היחה םע</verse>
        <verse osisID="Rev.17.13" n="13">׃היחהל םתרובגו םחוכ תא ונתי םהו דחא הבשחמ שי םהלו</verse>
        <verse osisID="Rev.17.14" n="14">ומיעו םיכלמה ךלמו םינודאהמ ןודא אוה יכ םתוא חצני השהו השה םע המחלמ ושעי םהו ׃םינימאמהו םיריחבה</verse>
        <verse osisID="Rev.17.15" n="15">׃םימואו תותורבחו םימע םה הנוזה בשיש תיארש םימה יל רמא אוהו</verse>
        <verse osisID="Rev.17.16" n="16">הרשב תא ולכאיו הנממ הממש ושעיו הנוזהל םיאנוש ויהי םה היחה לע תיארש םינרק הרשעהו ׃התוא ופרשת שא םעו</verse>
        <verse osisID="Rev.17.17" n="17">׃֞ה תרוביד אלכתש דע היחהל היתורשע ןתיל ונוצר תושעל םהיבבלב ןתנ ֞ה יכ</verse>
        <verse osisID="Rev.17.18" n="18">׃ץרא יכלמ לכ לע ךלמה הלודגה ריעה איה תיארש השאהו</verse>
      </chapter>
      <chapter osisID="Rev.18">
        <verse osisID="Rev.18.1" n="1">׃ורואמ ריאה המדאהו הלודג הרובגו חכ היה ולו םימשמ דרי רחא ךאלמ יתיאר ךכ רחאו</verse>
        <verse osisID="Rev.18.2" n="2">םיאמטה לכ ריתסהלו םינטשה תרידל התייהו לבב הלודגה ריעה הלפנ הלפנ רמאו וחכ לכב קעצו םיצרשו תופועמ ׃ Hebrew Transcription</verse>
        <verse osisID="Rev.18.3" n="3">תונזי ושע ץרא יכלמו הניימ ותש םלוכ יכ496 ׃הלודגה םהיתואתמ ורשעתנ םירחוסה לכו המיע</verse>
        <verse osisID="Rev.18.4" n="4">׃היתונווע ליבשב המיע ושנעתנ אלש ידכ ימע הנממ ואצ רמאו םימשמ רחא לוק יתעמשו</verse>
        <verse osisID="Rev.18.5" n="5">׃התוא רוכזת ֞הו םימשה לא עגנ היתונווע יכ</verse>
        <verse osisID="Rev.18.6" n="6">׃הישעמ יפכ םיילפכ לפכ הל םלשו הל ושע התשע רשאכו</verse>
        <verse osisID="Rev.18.7" n="7">הל ושע הז דציכ היתוואת רחא הכלהו האגתה רשאכו אלו הכלמ ינא הבילב בשחמ איה יכ םיוניע ׃הארא אל רעצ םושו הנמלא היהא</verse>
        <verse osisID="Rev.18.8" n="8">֞ה ןודאה םזוע יכ ףרשת שא םעו בערהו רעצהו תומה דחא םויב םהיתורעצ אבי הז ליבשבו ׃התוא טופשיש Hebrew Transcription</verse>
        <verse osisID="Rev.18.9" n="9">׃שאהמ ןשעה וארתש םאב המיע תונז ושעש ץרא יכלמ הילע וממשו</verse>
        <verse osisID="Rev.18.10" n="10">׃ךיתרבש אבי םואתפ לבב הלודגה ריעה ההאו ייוא ורמאיו המיא ינפמ קוחרמ ודמעי המהו</verse>
        <verse osisID="Rev.18.11" n="11">׃םהמ הרוחס דוע דחא םוש הנקי אלש ליבשב ךילע וקרשו וכבי םירחוסהו</verse>
        <verse osisID="Rev.18.12" n="12">לזרבו ףסכ לש םילכ ינימו םיציע ינימ לכו ישמו תוילגרמו םיבוט םינבאו ףסכו בהזמ הרוחסה ׃תרפועו לידבו</verse>
        <verse osisID="Rev.18.13" n="13">׃םדא תומשנו םילגעו םיסוסו םישבכו םירקבו םיטיחו ןבל םחלו ןמשו ןייו</verse>
        <verse osisID="Rev.18.14" n="14">׃דוע אצמת אלו ךלה םיבושחה לכו ךממ ךלה ךל חור תחנל היהש תוריפהו</verse>
        <verse osisID="Rev.18.15" n="15">׃הילע וכביו קוחרמ ודמעי םירבדה וליא הל ורכמש םירחוסהו</verse>
        <verse osisID="Rev.18.16" n="16">׃תוילגרמו םיבוט םינבאבו בהזבו ישמב שובל היהש לבב הלודגה ריע ההאו יוא ורמאיו</verse>
        <verse osisID="Rev.18.17" n="17">ךברעמ לכה ברחנ רחא העשב יכ502 ישנא לכו ךברעמ יברעו ךקדב יקיזחמ ךילבחו ךיחלמ ׃קוחרמ ודמעי ךתמחלמ</verse>
        <verse osisID="Rev.18.18" n="18">׃הלודגה ריעל המדנ ימ םירמואו ןשעה וארש תעשב םיקעוצו</verse>
        <verse osisID="Rev.18.19" n="19">הנממ יכ לבב הלודגה ריעל יוא יוא םירמואו םילבאתמו םיכובו םיקעוצו םהישאר לע רפע וקרזיו ׃לכה ברחנ דחא העשב וישכעו היתרוחסמ םיב תוניפס םהל היהש םירחוסה לכ ורשעתנ</verse>
        <verse osisID="Rev.18.20" n="20">׃הב םכיתמקנ תא םקנ ֞ה יכ ויאיבנו וישודקו םימשה וחמשת</verse>
        <verse osisID="Rev.18.21" n="21">םוקת אלו לבב עקשת הככ רמאו םיב ותוא קרזו םיחר ןבא ומכ לודג ןבא דחא חקל דחא ךאלמו</verse>
        <verse osisID="Rev.18.22" n="22">ילעבמ הכאלמ ילכ םוש אלו הלכ לוקו ןתח לוק החמש לוקו ןושש לוק הב דוע עמשנ אלו ׃ךב דוע עמשנ אל םייחורהמ לוקהו תוכאלמ</verse>
        <verse osisID="Rev.18.23" n="23">לכ ותיסה ךיפושכ יע יכ המדאה ידי לע םירש ויה ךלש םירחוסה יכ תרואמה רוא דוע חרזי אלו</verse>
        <verse osisID="Rev.18.24" n="24">׃המדאה לע וגרהנש וליא לכמו םיאיבנו םישודקה םד אצמנ הבו</verse>
      </chapter>
      <chapter osisID="Rev.19">
        <verse osisID="Rev.19.1" n="1">֞הל היהת תראפתו הרובגו דובכו היוללה םירמואה הלודג התורבחמ דחא לוק יתעמש ךכ רחאו</verse>
        <verse osisID="Rev.19.2" n="2">וידבע ימד תא םקנו התונז םע ץראה תיחשמה הלודגה הנוזה תא טפשש וטפשמ תמאו קדצ יכ</verse>
        <verse osisID="Rev.19.3" n="3">׃רודל רודמ ךלה ןשעהו היוללה תינש םעפ םירמואו</verse>
        <verse osisID="Rev.19.4" n="4">תויח עבראהו םיניקז םירשעו עבראהוםילפונ ןמא םירמואו אסכה לע בשויה ֞הל םיללפתמו ׃ןמא היוללה</verse>
        <verse osisID="Rev.19.5" n="5">םיארי תמחו ֞ה םש תא וללה ֞ה ידבע וללה היוללה אסכהמ אצי דחא לוקו521 לכה וינפל םהינש522 ׃םילדגו םינטק</verse>
        <verse osisID="Rev.19.6" n="6">היוללה םירמואה םילודג תולוק ומכו םילודג םימ לוקכו לודג התורבחמ לוקכ דחא לוק יתעמשו ׃רבג ֞ה יכ</verse>
        <verse osisID="Rev.19.7" n="7">׃תנכומ ותשאו אב השהמ הנתחה ןמזה יכ דובכ ול ןתילו םיחמש וניהנ</verse>
        <verse osisID="Rev.19.8" n="8">׃הפיו בוטו יקנ ישמב שובלל הל ןתונו</verse>
        <verse osisID="Rev.19.9" n="9">׃תמאב ֞ה ירבד הלא יל רמא אוהו השה םע ברע תליכא לוכאל ארקש םה םישודק יל רמא אוהו</verse>
        <verse osisID="Rev.19.10" n="10">םהל שיש וליאמו ךיחאמו ךירבח ינא השעת לא האר יל רמא אוהו ול ללפתל וילגרל יתלפנו ׃֞הל ךתלפת ישע ו֞שימ תודיעה</verse>
        <verse osisID="Rev.19.11" n="11">טופשי אוהו תמאו ןמאנ היה ומש וילע בשיש הזו ןבל דחא סוס יתיארו םיחתפנ םימשהש יתיארו</verse>
        <verse osisID="Rev.19.12" n="12">קר ותוא עדוי דחא םושו וילע בותכ דחא םשו םירתכ הברה ושאר לעו שא תבהלכ היה ויניעו ׃ודבל אוה</verse>
        <verse osisID="Rev.19.13" n="13">׃֞ה רוביד היה ומשו םד וילע קרז היהש דחא שובלמב שובלו</verse>
        <verse osisID="Rev.19.14" n="14">׃הניבל ישמ לש ישובלמ םישבול םלוכו הניבל יסוס לע וירחא םיכלוה םימשה תואבצ לכו</verse>
        <verse osisID="Rev.19.15" n="15">יונעל רושימב חיכוהו לזרב טבשב םתוא גהני אוהו םימעה וב תוכהל ידכ תויפיפ ברח ךלה ויפמו ׃֞ה ףא ןורחב ץרא</verse>
        <verse osisID="Rev.19.16" n="16">:םינודאה ןודאו םיכלמה ךלמ ךכ ודגב לע בותכ דחא םשו</verse>
        <verse osisID="Rev.19.17" n="17">ופסא וכל םימשה תחתמ םהש תופועה לכל רמאו לודג לוקב קעצו שמשב דמע דחא ךאלמ יתיארו :לודגה יהלאמ בֶרֶע תליכאל םכלוכ</verse>
        <verse osisID="Rev.19.18" n="18">הילע םיבכרה וליאמו םיסוסה רשבו םירובגמ רשבהו םירשהו םיכלמהמ רשבה ולכאתש ידכ :םיררחושמו םידבעמו םילודגו םינטקה רשבהו</verse>
        <verse osisID="Rev.19.19" n="19">לע בשיש הז םע המחלמ תושעל םהינחמ תא ופסא ץרא יכלמו היחה יתיארו אסכה530 וינחמ םעו531:</verse>
        <verse osisID="Rev.19.20" n="20">היחהמ ןמיסה וחקלש וליאל תיסהל ידכ וינפל תותואה השועה רקשה איבנ םע היחה הבשנו םיללפתמ :תירפוגב רעובה לואשב וכלשנו ול</verse>
        <verse osisID="Rev.19.21" n="21">וגרהנ םירחאהוי֞ע בשיש הזמ ברחה535 :םרשבמ ועבשנ הדשיה תויח לכו ויפמ אציש סוסה לע</verse>
      </chapter>
      <chapter osisID="Rev.20">
        <verse osisID="Rev.20.1" n="1">:הלודג תלשלש ודיבו םוהתמ חתפמה היה ולו םימשמ דרי דחא ךאלמ יתיארו</verse>
        <verse osisID="Rev.20.2" n="2">:םינש ףלא ותוא רסאו ןטשה איהש ןינתה חקלו</verse>
        <verse osisID="Rev.20.3" n="3">ףלא אלכש דע םימעה תיסהל לכוי אלש ידכ הלעמלמ םתחו ותוא רוגסו םוהתל ותוא ךילשהו ׃טעומ ןמז שפח היהי ךב רחאו םינש</verse>
        <verse osisID="Rev.20.4" n="4">אלש וליאו ו֞שי לע םידיעמו םינימאמה וליא טופשל ןתונ םהלו םהילע םיבשוי םהו תואסכ יתיארו ושי םע םילשומו םייח וליאו ולש לספל וא ול וללפתנ אלו היחהמ ןמיסה םהיחצמ לע וחקל540 :םינש ףלא</verse>
        <verse osisID="Rev.20.5" n="5">:הנושארה תמוקת איה הזו םינש ףלאה אלכש דע םימק אל םירחא םיתמה לבא</verse>
        <verse osisID="Rev.20.6" n="6">ויהי המה קר תרחא תוממ חפ שי אל םהילע יכ הנושארה המוקתב קלח ול שיש ימ אוה שודק :םינש ףלא ומיע םילשומו וחישמו ֞הל םינהכ</verse>
        <verse osisID="Rev.20.7" n="7">:וירמושמ ןטשה לאגי םינש ףלא רחאו</verse>
        <verse osisID="Rev.20.8" n="8">שי םרפסמו המחלמל אובל ולייח תא ףסאל גוגמו גוגו ץראה תוניפ עברא לע םימעה תיסהל ךליו :םיה לוחכ</verse>
        <verse osisID="Rev.20.9" n="9">ףרשו םימשמ שא לפנו הבוהאה ריעהו םישודקה תולייחה ובבסו המדאה בחר לע וסרד םהו</verse>
        <verse osisID="Rev.20.10" n="10">םוי םתוא ונעתיו רקשה איבנו המה םש היהש לואשה לש שאב ךלשוה םתוא תיסמה ןטשהו :םלוע דעו םלועמ הלילו</verse>
        <verse osisID="Rev.20.11" n="11">:םוקמ ול אצמנ אלו המדאהו םימשה סב וינפמו וילע בשיש הזו היה ןבלו לודג אסכ דחא יתיארו</verse>
        <verse osisID="Rev.20.13" n="13">:וישעמ יפכ דחא לכ וטפשיו םיתמה תא ןתנ לואשה תמהו ץוחל הב ויהש םיתמה תא םיה קרזו</verse>
        <verse osisID="Rev.20.14" n="14">:תרחא תומ תאזו שאב ךלשנ םנהיגהו תומהו</verse>
        <verse osisID="Rev.20.15" n="15">:שאב ךלשוה םייחה רפסב בותכ דחא אצמנ אל םאו</verse>
      </chapter>
      <chapter osisID="Rev.21">
        <verse osisID="Rev.21.1" n="1">:דוע שׁי אל םיהו עוגי םינושארה ץראהו םימשה יכ השדח המדאו םישדח םימש יתיארו</verse>
        <verse osisID="Rev.21.2" n="2">השאכ היה טשקמו ץראל םימשמ דרי השדחה םילשורי השודקה ריעה יתיאר סיננאי ינאו :הלעב ינפל טקשמה</verse>
        <verse osisID="Rev.21.3" n="3">:םעל ול ויהי םהו םיהלאל םהל היהו םדאה לצא ֞ה ןכשמ האר רמאש אסכהמ לודג לוק יתעמשו</verse>
        <verse osisID="Rev.21.4" n="4">יכ םיוניעו תוקעצו רעצ םוש אלו דוע לשמי אל תומהו םינפ לכ לעמ העמד םיהלא ֞ה החמו ׃רבע ןושארה</verse>
        <verse osisID="Rev.21.5" n="5">תמא םירבדה הלא יכ בותכ יל רמא אוהו שדח לכה יתישע ינא האר רמא אסכה לע בשיש הזו</verse>
        <verse osisID="Rev.21.6" n="6">:םנחב םייח םימ אמצהל ןתא ינאו ףוסהו תליחת ןורחאהו ןושארה ינא לכה רבע יל רמאו</verse>
        <verse osisID="Rev.21.7" n="7">:ןבל יל היהי אוהו םיהלאל ול היהי ינאו לכהמ שרוי היהי חצנמש ימ</verse>
        <verse osisID="Rev.21.8" n="8">לואשה שאמ םרכש תא ןתא םינבזכלו םיפשכמלו םינוזלו םינחצרלו םינימאמ וניאהל לבא :הינשה התימה איה תאזו תירפגו שאב ףרושה</verse>
        <verse osisID="Rev.21.9" n="9">אב יל רמאו םינורחא םיעגנ העבשב םיאלמ תורעקה םדיב היהש םיכאלמ העבשהמ דחא יל אבו :השהמ הַלַכה הָּׁשִאה הארו</verse>
        <verse osisID="Rev.21.10" n="10">דרי םילשורי השודקה ריעה הלודגה ריעה יל הארהו הובגו לודג היהש דחא רה לע יתוא גהנו ׃ץראל םימשמ</verse>
        <verse osisID="Rev.21.11" n="11">:הפשי ארקנה הבוט ןבאה לש רואכ היה הרואמו הילע ֞ה תראפתו</verse>
        <verse osisID="Rev.21.12" n="12">תומש רשע םיינשו םיכאלמ רשע םיינש םירעשה לעו םירעש רשע םיינשו םילודג המוח היה הלו :לארשי לש םיטבש רשע םיינשמ</verse>
        <verse osisID="Rev.21.13" n="13">:השלש םורדמו השלש ןופצמו השלש ברעממו םירעש השלש חרזממ</verse>
        <verse osisID="Rev.21.14" n="14">לש םיחולש רשע םיינשמ תומשה בותכ היה םהבו תודוסי רשע םיינש הב ריעה תמוחלו</verse>
        <verse osisID="Rev.21.15" n="15">:םירעשהו המוחהו ריעה וב תודמל ידכ בהז לש דחא הנק ודיב היה ימיע רבדש הזו</verse>
        <verse osisID="Rev.21.16" n="16">הבראו הדשה תורבק ףלא רשע םיינש הנקה םע ריעה דדמו הבחרכ הכראו תעברב חנומ ריעהו :םיוש המה ריעהמ הובגו הבחרו</verse>
        <verse osisID="Rev.21.17" n="17">:ךאלמהל היהש םדא תדמכ תומא םיעבראו עבראו האמ ויה היתומוחו</verse>
        <verse osisID="Rev.21.18" n="18">:רוהט בהזמ ריעהו הפשימ היה המוחהו</verse>
        <verse osisID="Rev.21.19" n="19">ריפס ינשה תחא הפשי היה ןושארה דוסיה םיבוט םינבאב טשקמ ויה ריהמו המוחהמ דוסיהו :ךפנ יעיברהו זעלב ריִנָּׁדִיקלאק ישילשהו</verse>
        <verse osisID="Rev.21.20" n="20">ובש ירישעהו הדטפ יעישתהו שישרת ינימשהו המלחא יעיבשהו םהש ישישהו םדא ישימחהו :טִסיִטֶמַא זעלב ארקנ רשע םיינשהו םשל רשע דחאהו</verse>
        <verse osisID="Rev.21.21" n="21">ויה ריעה תובוחרו דחא תוילגרממ היה דחא רעש לכו תוילגרמ ןמ ויה םירעש רשע םיינשהו :ךז חולצכ רוהט בהזמ</verse>
        <verse osisID="Rev.21.22" n="22">:השהו םהלש שדקמה תיב היה תואבצ ֞ה יכ הליפתה תיב הב יתיאר אלו</verse>
        <verse osisID="Rev.21.23" n="23">:השה שי הרואו םהל רואמ ֞ה תראפת יכ חריהמ וא שמשמ רוא ריעה ךירצ אלו</verse>
        <verse osisID="Rev.21.24" n="24">:הב םליח תא ואבי ץרא יכלמו הזה רואב םיכלוה םישודקה םימעהו</verse>
        <verse osisID="Rev.21.25" n="25">:הליל היהי אל יכ ורגסי אל הלילו םמוי דימת ךירעש וחתפו</verse>
        <verse osisID="Rev.21.26" n="26">:םימעהמ דובכו תראפת הב ואבי המהו</verse>
        <verse osisID="Rev.21.27" n="27">:םייחה רפסב םמש בותכש וליא קר וילא ברקי אל רזו</verse>
      </chapter>
      <chapter osisID="Rev.22">
        <verse osisID="Rev.22.1" n="1">ו:השהו ֞ה אסכמ אצי המלחאכ ךזו םייח םיממ אלמ היהש דחא לחנ יל הארה</verse>
        <verse osisID="Rev.22.2" n="2">םיינש היה וילעו םייחה ץעו לכאמ ץע לכ הזמו הזמ ותפש לע הלעי לחנה לעו תובוחרה עצמאב רשע ׃הפורתל והלעו לכאמל ויריפ היהו תוריפ ינימ</verse>
        <verse osisID="Rev.22.3" n="3">:והותרשי וידבעו הב ןוכשי השהו ֞ה אסכו דוע היהי אל םרחו</verse>
        <verse osisID="Rev.22.4" n="4">׃םהיחצמב בותכ היהי ומשו וינפ תא ואריו</verse>
        <verse osisID="Rev.22.5" n="5">ךיהלאו םלוע רואל ֞ה ךל היהו ךל ריאי אל חריהו הגנלו םמוי רואל שמשה הב דוע היהי אלו :ךתראפתל</verse>
        <verse osisID="Rev.22.6" n="6">׃בורקב היהיש המ וידבעל תוארהל ויכאלמ תא חלש תואבצ ֞הו תמא ןה םירבדה הלא יל רמאו</verse>
        <verse osisID="Rev.22.7" n="7">׃הזה רפסב בותכש המ תואיבנה ירבדב ןימאמש ימ אוה שודקו הרהמב אב ינא האר</verse>
        <verse osisID="Rev.22.8" n="8">יתללפתהו ץראל יתלפנ תאז יתיארו יתעמשש ןויכו הלא לכ יתיארו יתעמש סיננהאי ינאו :תאז יל הארהש ךאלמהל</verse>
        <verse osisID="Rev.22.9" n="9">םימייקמה וליאמו םיאיבנה םיחאמו ךתורבחמ ינא םג יכ תאז השעת לא האר יל רמא אוהו :֞הל ךתליפת ישע הזה רפסמ םירבדה</verse>
        <verse osisID="Rev.22.10" n="10">:בורק תעה יכ הזה רפסמ ןוזחה םתסת לא יל רמאו</verse>
        <verse osisID="Rev.22.11" n="11">שיש ימו ךכ תע לכ היהי דיסח שיש ימ לבא ךכ ֜כ֜ג היהי אמט שיש ימ ןכ תע לכ היהת ער שיש ימ :הז ומכ ןכ םג שודק</verse>
        <verse osisID="Rev.22.12" n="12">:והשעמכ שיא לכל םלשל הרהמב אבי ינא הארו</verse>
        <verse osisID="Rev.22.13" n="13">:ףוסהו תליחת ןורחאהו ןושארה ינא</verse>
        <verse osisID="Rev.22.14" n="14">:ריעהמ ךליל הכזיו םייחה ץעב קלח םהל היהיש ידכ ויתוצמ םישועש םה םישודק</verse>
        <verse osisID="Rev.22.15" n="15">:םינבזכהו םינחצרהו תונזהו םיפשכמהו בלכה םידמוע ץוחבמ יכ</verse>
        <verse osisID="Rev.22.16" n="16">:דוד תחפשממ שרש ינאו הדעל תוארהל יכאלמ יתחלש ו֞שי ינא</verse>
        <verse osisID="Rev.22.17" n="17">אולבו ףסכ אולב ותשו םייח םימל וכל אמצש ימו אב רמאי עמשש ימו אב ורמא הלכהו חורהו</verse>
        <verse osisID="Rev.22.18" n="18">֞ה וילע ףיסוי םירבד הזיא ול ףיסוי דחאש אבו הזה רפסהמ תואיבנה םיעמושה לכל דיעמ ינא לבא :הזה רפסב םיבותכש םיעגנה</verse>
        <verse osisID="Rev.22.19" n="19">ו :םייחה רפסמ ומש תא ֞ה החמי רפסמ הזמ םירבד הזיא ערגי דחאש םאב</verse>
        <verse osisID="Rev.22.20" n="20">:ושי ןודא אב ןכ ןמא הרהמב אבא ינא ןכ תאז דיעמה רמא הכו</verse>
        <verse osisID="Rev.22.21" n="21">:ןמא םכלוכ םע היהי חישמה ושי ונינודאמ דסחה</verse>
      </chapter>
    </div>
  </osisText>
</osis>
