    <div type="book" osisID="John">
      <chapter osisID="John.1">
        <verse osisID="John.1.1" n="1">הָיָה הַדַבָר בְרֵאשִׁית וְהַדַבָר הַיָה אֵצֶל הַאֱ˄הִים ה הַדַבָרוְהַאֱ˄הִים הוּא הָיָ</verse>
        <verse osisID="John.1.2" n="2">יָה בְרֵאשִׁית אֵצֶלזֶה הָ</verse>
        <verse osisID="John.1.3" n="3">כָל הַדְּבָרִים הַאֱ˄הִים. לֹא בוֹ וּמִבִלְﬠַדָיו נֶﬠֱשֹוּ נֶﬠֱשָֹה<note type="footnote" n="16">The form וּשֲׂﬠַנ is found in Mishnah, Yoma 3:10 in the Kaufmann manuscript.</note> <note type="footnote" n="17">A Patach is expected in the Bet.</note> </verse>
        <verse osisID="John.1.4" n="4">בוֹ דָבַר מִכָל אֲשֶר הָיָה. הָיוּ הַחַיִים. וְהַחַיִים הַיוּ אוֹר</verse>
        <verse osisID="John.1.5" n="5">וְהַאוֹר הַיָה הַאֲנַשִׁים. ˄ות וְהַאֲפֵ˄ות בַאֲפֵ זוֹרֵח לֹא<note type="footnote" n="18">Furtive Patach is missing under Chet.</note> </verse>
        <verse osisID="John.1.6" n="6">אִישׁ אֵחָד וַיְהִי הֵכִילוּהוּ. שָלוּחַ מֵאֵת הַאֱ˄הִים</verse>
        <verse osisID="John.1.7" n="7">זֶה בָא נָןוּשְמוֹ יוֹחָ בְﬠֵדוּת לְהַﬠִיד ﬠַל הַאוֹר לְמַﬠָן בַﬠֲבוּרוֹ.אֲשֶר יַאֲמִינוּ הַכָל</verse>
        <verse osisID="John.1.8" n="8">הוּא לֹא הָיָה הַאוֹר כִי אִם</verse>
        <verse osisID="John.1.9" n="9">הָיָה לְהַﬠִיד ﬠַל הַאוֹר. י הַמֵאִיר לְכָלאוֹר אַמִתִּ אָדָם הַבָא אֶל הַעוֹלָם הַזֶה.</verse>
        <verse osisID="John.1.10" n="10">הוּא הָיָה בַעוֹלָם . וְהַעוֹלָם בוֹ ם נֶﬠֱשָהוְהַעוֹלָ<note type="footnote" n="19">Sin dot omitted.</note> </verse>
        <verse osisID="John.1.11" n="11">בַא אֶל לֹא הִכִירוּהוּ. מוֹלַדְתוֹ מַמָש וּבְנֵי בֵיתוֹ לא<note type="footnote" n="20">Cholam omitted.</note> </verse>
        <verse osisID="John.1.12" n="12">וּלְכָל אֲשֶר קִבְלוּהוּ. קִבְלוּהוּ וּמַאֲמִינִים בִשְמוֹ נָתַן מֵמְשָלָה שֶיִהְיוּ<note type="footnote" n="21">Shin dot omitted.</note> </verse>
        <verse osisID="John.1.13" n="13">אֲשֶר ˄הִים. בְנֵי הַאֱ הֵם לֹא מִדַּם ר וְלֹא מֵחֵפֶץ שָׂ וְלֹא מֵחֵפֶץ הַבָ נוֹלָדוּ כִי אִם מֵאֶתאָדָם<note type="footnote" n="22">Shin dot omitted.</note> </verse>
      </chapter>
    </div>
  </osisText>
</osis>
