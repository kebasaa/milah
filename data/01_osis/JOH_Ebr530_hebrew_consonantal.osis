    <div type="book" osisID="John" canonical="true">
        <div type="introduction" canonical="true"><title type="main" canonical="true">הבשורה הקדושה של ישוע המשיח כפי יוחנן</title></div>
        <title type="chapter" canonical="true">פרק ראשון</title>
        <chapter sID="John.1" osisID="John.1" n="1"/>
        <verse sID="John.1.1" osisID="John.1.1" n="1"/><milestone type="pb" n="2v"/>בראשית היה הדבר והדבר היה אצל האלהים והאלהים הוא היה הדבר<verse eID="John.1.1"/>
        <verse sID="John.1.2" osisID="John.1.2" n="2"/>זה היה בראשית אצל האלהים.<verse eID="John.1.2"/>
        <verse sID="John.1.3" osisID="John.1.3" n="3"/>כל הדברים נעשו בו ומבלעדיו לא נעשה דבר מכל אשר היה.<verse eID="John.1.3"/>
        <verse sID="John.1.4" osisID="John.1.4" n="4"/>בו היו החיים. והחיים היו אור האנשים.<verse eID="John.1.4"/>
        <verse sID="John.1.5" osisID="John.1.5" n="5"/>והאור היה זורח באפלות והאפלות לא הכילוהו.<verse eID="John.1.5"/>
        <verse sID="John.1.6" osisID="John.1.6" n="6"/>ויהי איש אחד שלוח מאת האלהים ושמו יוחנן<verse eID="John.1.6"/>
        <verse sID="John.1.7" osisID="John.1.7" n="7"/>זה בא בעדות להעיד על האור למען אשר יאמינו הכל בעבורו.<verse eID="John.1.7"/>
        <verse sID="John.1.8" osisID="John.1.8" n="8"/>הוא לא היה האור כי אם להעיד על האור.<verse eID="John.1.8"/>
        <verse sID="John.1.9" osisID="John.1.9" n="9"/>היה אור אמתי המאיר לכל אדם הבא אל העולם הזה.<verse eID="John.1.9"/>
        <verse sID="John.1.10" osisID="John.1.10" n="10"/>הוא היה בעולם והעולם נעשה בו. והעולם לא הכירוהו.<verse eID="John.1.10"/>
        <verse sID="John.1.11" osisID="John.1.11" n="11"/>בא אל מולדתו ממש ובני ביתו לא קבלוהו.<verse eID="John.1.11"/>
        <verse sID="John.1.12" osisID="John.1.12" n="12"/>ולכל אשר קבלוהו ומאמינים בשמו נתן ממשלה שיהיו בני האלהים.<verse eID="John.1.12"/>
        <verse sID="John.1.13" osisID="John.1.13" n="13"/>אשר הם לא מדם ולא מחפץ הבשר ולא מחפץ אדם נולדו כי אם מאת האלהים<verse eID="John.1.13"/>
        <chapter eID="John.1"/>
      </div>
  </osisText>
