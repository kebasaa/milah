    <div type="book" osisID="Rev">
      <chapter osisID="Rev.1">
        <verse osisID="Rev.1.1" n="1">חֲזוֹן יְּהוֹׁשֻׁעַ מָׁשִׁיחַ שֶׁנְּתָנֹו הָא לֹהִׁים לְּהַרְּאוֹת עֲבָדָיו אֲׁשֶר הֻׁצרְָך לִׁהְּיֹות בְּׁשֶצֶף וְּהוֹרָה שׁוֹלֵחַ בְּיַד הַמַלְּאָכוֹ לָ עַבְּדּוֹ יֹוחָנָן:<note type="footnote" n="2">יִׁנֵשׁ רַעַשַה The Second Gate</note> </verse>
        <verse osisID="Rev.1.2" n="2">אֲׁשֶר הֵעִׁיד הַדְּּבַר הָא לֹהִׁים וְּהָעֵדַת יְּהוֹׁשֻׁעַ מָׁשִׁיחַ אֲׁשֶר חָזָה וְּׁשֶהֵנָה וְּׁשֶהֻׁצְּרָךְ לַעֲׂשוֹת<note type="footnote" n="3">The word הָנֵה "here" appears four times in the text, perhaps having the idiosyncratic meaning of "these".</note> </verse>
        <verse osisID="Rev.1.3" n="3">אַחֲרֵי-זאֹּת: אַׁשְּרֵי הָאִׁיׁש אֲׁשֶר-קוֹרֶא וְּה וְּ הַשֹּמְּעִׁים הַדִּׁבְּרֵי הַנְּבוּאָה ומְּׁשַמְּרִׁים הֵנָה אֲׁ שֶר-בָּה כְּתוּבוֹת: כִׁי הָעֵת קָרוֹב:</verse>
        <verse osisID="Rev.1.4" n="4">יֹוחָנָן לְּׁשִׁבְּעָה הַמַקְּהֵלִׁים הֵם-בָאָׂשִׁיאָה חֵן-לָכֶם וְּׁשָלוֹם מִׁמֶנּו הוֹיֶה וַיִׁהְּיֶה וְּׁ שֶיָבוֹא וּמִׁשֶבַע הַנְּׁשָ מוֹת שֶׁנֶגֶד הַכִׁסְּאוֹ</verse>
        <verse osisID="Rev.1.5" n="5">r וְּ מִׁיהוֹׁשֻׁעַ מָׁשִׁיחַ שֶׁעֵד הַנֶא מָן הַבְּכֹּר-מִׁן-הַמְּתִׁים וְּהַשַ ר- הַמְּלָכִׁים הָאָרֶץ אֲׁשֶר אֲהַבָנוּ וַיִׁטְּבוֹלֵנוּ מֵחֲטָאֵינּו<note type="footnote" n="4">Literally, "men" based on the vowels in the manuscript. "Firstborn of the dead" would be םיִׁתֵמַה.</note> </verse>
        <verse osisID="Rev.1.6" n="6">בַדָּמוֹ: וַעֲׂשָנּו אֶת-מַלְּכוּת וְּכֹּהֲנִׁים לֵאלֹהִׁים וְּאָבִׁיהוּ: לוֹ-כָבוֹד וְּהַשִׁלְּטוֹן עַד-עוֹלְּמֵי עָ ד: אָמֵן:</verse>
        <verse osisID="Rev.1.7" n="7">הִׁנֵה בָא עִׁם הֶעָנָן וְּחָזָהוּ עַיִׁן וְּהָאֵלֶא עָלָיו כָל-הַשִׁבְּטֵי הָאָרֶץ: גַם אָמֵן:<note type="footnote" n="5">Should be הֶלֵאְּו.</note> </verse>
        <verse osisID="Rev.1.8" n="8">אֲנִׁי הָאָלֶף וְּהַתָו אֹּמֵר יְּהוָֹה הָאֶלֹהִׁים הוֹיֶה וַ יִׁהְּיֶה וְּׁשֶיָבוֹא הַשַדָּ י:</verse>
        <verse osisID="Rev.1.9" n="9">הַדְּּבַר הָא לֹהִׁים וּבַעֲבוּר- הָעֵדוּת</verse>
        <verse osisID="Rev.1.10" n="10">יְּהוֹׁשֻׁעַ מָׁשִׁיחַ : הָיִׁיתִׁי בְּרוּחַ בַיֹום<note type="footnote" n="6">The unique form יִׁיִׁנֹּדֲא is apparently an adjective derived from יָנֹּדֲא or יִׁנֹּדֲא.</note> </verse>
        <verse osisID="Rev.1.11" n="11">חֲצֹּצְּרָה הָאֹּמֵר שֶׁחזֶֹּה אַתָה כְּתוֹב ב בְּסֵפֶר וּׁשְּלַח אֶל-שִׁׁבְּעָה הַמַקְּהֵלִׁים אֶל אֵפְּׂשוּס וְּאֶל-סְּמֻׁרְּנָה וְּאֶל פֶרְּגָמוּׂש וְּאֶל-תִׁיאָטִׁירָה וְּאֶל סַרְּּדִׁׂש וְּ וְּאֶל-פִׁילָדֶלְּפִׁיאָה וְּאֶל- לָאוֹדִׁיקִׁיאָה</verse>
        <verse osisID="Rev.1.12" n="12">וְּׁשָם פָנִׁיתִׁי לְּהַבִׁיט הַקוֹל אֲׁשֶר דִׁבֶר- אִׁתִׁי: וְּפֹּנֶה אֲנִׁי רָאִׁיתִׁי אֶת- מְּנֹורוֹת ה</verse>
        <verse osisID="Rev.1.13" n="13">הַזָהָב שֶׁבַע וּבְּקֶרֶב הַשֶבַע מְּנֹורוֹת מ מִׁמְּׁשָל לְּבֶן הָאָדָם לָבוּׁש עִׁים- כְּתנֶֹּת</verse>
        <verse osisID="Rev.1.14" n="14">וְּהָראֹּׁשוֹ וְּהַשַעֲרוֹת לְּבָנֹות כְּצֶמֶר צָחַר</verse>
        <verse osisID="Rev.1.15" n="15">כְּמוֹ-שָׁלֶג וְּעֵינָו כְּלַהַב אֵׁש: וּרְּגָלָיו מ מִׁמְּׁשָלִׁים לִׁנְּחֹּשֶת לֹהֲטִׁים בְּכוּר וְּקוֹלוֹ כְּקוֹל הַ צוּלָה<note type="footnote" n="7">The Shin-dot is missing in the manuscript.</note> </verse>
        <verse osisID="Rev.1.16" n="16">וְּאוֹחֵז בַיַד-יְּמִׁינֹו כוֹכָבִׁים שִׁׁבְּעָה וּמִׁן-הַפִׁיו הוֹלְֵך חֶרֶב פִׁיֹות וּפָנָיו כַשֶמֶׁש</verse>
        <verse osisID="Rev.1.17" n="17">אוֹרִׁים בָעֳזוֹ: וְּכַאֲׁשֶר רָאִׁיתִׁי אוֹתוֹ נ נָפַלְּתִׁי אֶל-רַגְּלָיו כְּמֵת וְּׂשָם</verse>
        <verse osisID="Rev.1.18" n="18">וְּהִׁנֵה חַי-אֲנִׁי לְּעֹּלְּמֵי-עֹּלָמִׁים אָמֵן וְּיֵׁש-לִׁי אֶת-הַמַסְּמְּרִׁים</verse>
        <verse osisID="Rev.1.19" n="19">הַמָוֶת וְּהַשְּאוֹל: לָכֵן כְּתֹּב שֶׁרָאִׁיתָ וְּׁשֶהֵנָ ה וְּׁשֶהֻׁצְּרָךְ לַעֲׂשוֹת אַחֲרֵי-זאֹּת</verse>
        <verse osisID="Rev.1.20" n="20">v הַסוֹד הַשִׁבְּעָה- כוֹכָבִׁים שֶׁרָאִׁיתָ בַיַד- יְּמִׁינִׁי והַשֶבַע-מְּנֹורוֹת הַזָהָב הַשִׁבְּעָה- כֹּכָבִׁים מַלְּאָכִׁים הַשִׁבְּעָה מַקְּהֵלִׁים הֵמָה וְּהַשֶבַע-מְּנֹורוֹת שֶׁרָאִׁיתָ שִׁׁבְּעָה-מַקְּהֵלִׁים הֵנָה הַשַעַר שֵׁנִׁי<note type="footnote" n="8">Should be הָמֵה.</note> </verse>
      </chapter>
      <chapter osisID="Rev.2">
        <verse osisID="Rev.2.1" n="1">לְּמַלְּאַךְ הַמַקְּהֵל בְּאֵפְּׂשוּס כְּ תוֹב הֵנָה אֹּמֵר שֶׁאוֹחֵז הַשִׁבְּעָה-כוֹכָבִׁים בַיַד-יְּמִׁינוֹ שֶׁהוֹלְֵך בְּתוְֹך הַשֶבַע-</verse>
        <verse osisID="Rev.2.2" n="2">מְּנֹּרוֹת הַזָהָב: וְּלאֹּ הֵמָה וּמְּצָתָם כֹּזְּבִׁים<note type="footnote" n="9">The extraneous Kamatz is in the manuscript.</note> <note type="footnote" n="10">The Shin-dot is missing in the manuscript.</note> <note type="footnote" n="11">Should be: םָתא צְּמוּ.</note> </verse>
        <verse osisID="Rev.2.3" n="3">וְּנָטַלְּתָ וּלְָּך אֶרֶךְ-אַפַיִׁם בַעֲבוּר שְּׁמִׁי וְּלאֹּ-</verse>
        <verse osisID="Rev.2.4" n="4">כָלִׁיתָ : כִׁי-אִׁם לִׁי-מְּאוּם עָלֶיָך כִׁי עָזַבְּתָ</verse>
        <verse osisID="Rev.2.5" n="5">הָאֲהָבְּךָ הָרִׁאׁשוֹן: וּזְּכוֹר מֵאַיִׁן נִׁלְּבַטְּתָ וְּ וְּהִׁנָחֵם וַעֲשֵה הָרִׁאׁשנִֹּׁים- מַעֲׂשִׁים: וְּאִׁם לאֹּ אָבוֹא-לְָּך פִׁתְּאֹּם-פֶתַע וְּאָזֻׁעַ הַמְּנֹורְָּך<note type="footnote" n="12">This Sin-dot is missing in the manuscript.</note> </verse>
        <verse osisID="Rev.2.6" n="6">מִׁמְּקוֹמוֹ לוּלֵי תִׁנָחֵם: כִׁי- אִׁם לְָּך זוֹאת כִׁי שׂוֹטֵם אַתָה הַמַעֲׂשֶה- נִׁיקוֹלָאִׁטיִׁיִׁם</verse>
        <verse osisID="Rev.2.7" n="7">שֶׁשוֹטֵם גַם-אֲנִׁי: לאֲׁשֶר אזֶֹּן יִׁׁשְּמָע מָה-הָרוּחַ אוֹמֶרֶת לְּמַקְּהֵלִׁים ח לַמְּנַצֵחַ אֶתֵן לֶא כֹּל מִׁן-הָעֵץ הַחַיִׁים אֲׁשֶר-בְּתוְֹך הַפַרְּדֵס הָא להִׁי :<note type="footnote" n="13">Cholam is missing in the manuscript.</note> </verse>
        <verse osisID="Rev.2.8" n="8">וּכְּתוֹב לְּמַלְּאַ ךְ הַמַקְּהֵל- בִׁסְּמֻׁרְּנָה וְּהֵנָה אֹּמֵר הָרִׁאׁשוֹן-וְּהָאַחֲרוֹן שֶׁהָיָה מֵת v</verse>
        <verse osisID="Rev.2.9" n="9">וְּחָיָה: יֹודֵעַ -אֲנִׁי הַמַעֲׂשֶיָך וְּהַצָרָה וְּהַ וּדַלָה כִׁי-אִׁם כָבֵד-אָ תָה וְּהַנְּאָצַת הַמְּדַבְּרִׁים יְּהוּדִׁיִׁים לִׁהְּיוֹת וְּלאֹּ הֵמָה כִׁי-אִׁם כְּנֶסֶת הַשָטָן.<note type="footnote" n="14">Yehudiyim is an adjective meaning "Judaic" and distinct from Yehudim, the normal word for "Jews". Yehudiyim was understood as referring to the Ten Lost Tribes who labeled themselves "Judaic", but not "Jewish". This is referred to in Genesis Rabbah, Vayechi, Section 97, "also in this world you will be honored that all the tribes will call themselves Yehudiyim, just as you are called Yehudah" " ףא הדוהי התא תארקנש םשכ ,םיידוהי ךמש לע םיטבשה לכ וארקיש הכזת הזה םלועב".</note> </verse>
        <verse osisID="Rev.2.10" n="10">תִׁירָא שֶׁהֻׁצְּרָךְ עֻׁנֹות וְּהִׁנֵה הַ אֲבַדּוֹן יִׁתֶן מִׁכֶם אֶל-בֵית הַ סֹּהַר לְּנַסוֹתְּכֶם: וְּלָכֶם צָרָה עָׂשָר יָמִׁים: ה יֵה נֶא מָן עַד מָוֶת וְּנָתַתִׁי לְָּך עֲטֶרֶת</verse>
        <verse osisID="Rev.2.11" n="11">הָחַיִׁים: לַ אֲׁשֶר-אזֶֹּן יִׁׁשְּמַ ע מָה ה לאֹּ</verse>
        <verse osisID="Rev.2.12" n="12">יְּנגַֻׁע מִׁן-הַמָ וֶת-הַשֵ נִׁי: וּלַמַלְּאַ ךְ הַ מַ קְּהֵל בְּפֶרְּגַ מוּׂש כְּתֹּב הֵנָה-אֹּמֵר לַאֲשֶר הַכֶרֶב<note type="footnote" n="15">Presumably בֶרֶכַה "the Cherub" is a scribal error for בֶרֶחַה "the sword".</note> </verse>
        <verse osisID="Rev.2.13" n="13">פִׁפִׁיֹות יֹודֵעַ -אֲנִׁי הַמַעֲׂשֶיָך וְּאֵיפֹּה יֹּׁשֵב אֵי-הַמוֹׁשַב-הַשָטָן</verse>
      </chapter>
    </div>
  </osisText>
</osis>
