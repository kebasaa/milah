        <language>he</language>
        <type type="x-manuscript">Manuscript</type>
        <identifier type="shelfmark">British Library, MS Sloane 273</identifier>
        <contributor role="trc" file-as="Gordon, Nehemia">Nehemia Gordon</contributor>
        <date event="eversion" type="ISO">2017</date>
