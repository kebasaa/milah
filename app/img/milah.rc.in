// Generated into the build directory by configure_file(); edit milah.rc.in,
// never the copy CMake writes. The version fields come from the project()
// declaration in app/CMakeLists.txt so Explorer and the About dialog cannot
// disagree about which release this is.
//
// The icon path is absolute because a .rc resolves relative paths against its
// own location, and the generated copy does not sit beside milah.ico. windres
// accepts forward slashes.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/img/milah.ico"

1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L  // VOS_NT_WINDOWS32
FILETYPE        0x1L      // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode. The Translation value below has to
        // agree with it or Explorer shows nothing at all.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jonathan D. M\xFCller"
            VALUE "FileDescription",  "Comparing Hebrew New Testament manuscript witnesses and building a combined edition"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "Milah"
            VALUE "LegalCopyright",   "Copyright \xA9 2026 Jonathan D. M\xFCller. GNU General Public License, version 3 or later."
            VALUE "OriginalFilename", "Milah.exe"
            VALUE "ProductName",      "Milah"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
