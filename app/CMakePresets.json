{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceParentDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MILAH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows (Qt MinGW kit)",
      "description": "Qt's MinGW kit and the MinGW, CMake and Ninja that ship with it. Pass the kit with -DCMAKE_PREFIX_PATH=<Qt>/<version>/mingw_64, or use build_milah_windows.ps1, which finds it.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos",
      "displayName": "macOS",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "windows-mingw", "inherits": "base", "configurePreset": "windows-mingw" },
    { "name": "linux", "inherits": "base", "configurePreset": "linux" },
    { "name": "macos", "inherits": "base", "configurePreset": "macos" }
  ]
}
